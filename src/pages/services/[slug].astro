---
import { getLocaleFromUrl } from "@/core/i18n";
import { getPublication } from "@/features/publication/publication";
import PublicationDetail from "@/features/publication/ui/PublicationDetail.astro";
import NotFoundPage from "@/features/site-shell/ui/pages/NotFoundPage.astro";
const locale = getLocaleFromUrl(Astro.url);
const slug = Astro.params.slug ?? "";
const found = getPublication(Astro.locals, locale).services.some((item) => item.slug === slug);
if (!found) Astro.response.status = 404;
---

{found ? <PublicationDetail kind="service" slug={slug} /> : <NotFoundPage />}
