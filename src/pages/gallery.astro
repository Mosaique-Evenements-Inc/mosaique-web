---
import { getLocaleFromUrl } from "@/core/i18n";
import { getPublication } from "@/features/publication/publication";
import { galleryTranslations } from "@/features/gallery/i18n";
import GalleryPage from "@/features/gallery/ui/pages/GalleryPage.astro";
const locale = getLocaleFromUrl(Astro.url);
const items = getPublication(Astro.locals, locale).events;
const title = `${galleryTranslations[locale].archiveTitle} — MOSAÏQUE EVENTS`;
---

<GalleryPage {items} {title} />
