---
import EventGallery from "../../components/events/EventGallery.astro";
import EventHeader from "../../components/events/EventHeader.astro";
import Footer from "../../components/sections/Footer.astro";
import Navigation from "../../components/sections/Navigation.astro";
import { eventDetails, type EventDetail } from "../../content/events";
import BaseLayout from "../../layouts/BaseLayout.astro";

import "../../styles/sections/event-detail.css";

export function getStaticPaths() {
  return eventDetails.map((event) => ({
    params: { slug: event.slug },
    props: { event },
  }));
}

interface Props {
  event: EventDetail;
}

const { event } = Astro.props;
---

<BaseLayout title={`${event.title} — MOSAÏQUE EVENTS`} description={event.description}>
  <Navigation surface="solid" anchorPrefix="/" />
  <main class="event-detail" id="main-content" tabindex="-1">
    <EventHeader title={event.title} description={event.description} status={event.status} />
    <EventGallery images={event.images} slug={event.slug} title={event.title} />
  </main>
  <Footer anchorPrefix="/" />
</BaseLayout>
