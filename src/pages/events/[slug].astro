---
import EventGallery from "../../components/events/EventGallery.astro";
import EventHeader from "../../components/events/EventHeader.astro";
import EventMoreGalleries from "../../components/events/EventMoreGalleries.astro";
import Footer from "../../components/sections/Footer.astro";
import Navigation from "../../components/sections/Navigation.astro";
import { eventDetails, type EventDetail } from "../../content/events";
import BaseLayout from "../../layouts/BaseLayout.astro";

import "../../styles/sections/event-detail.css";

export function getStaticPaths() {
  return eventDetails.map((event, index) => ({
    params: { slug: event.slug },
    props: { event, nextEvent: eventDetails[(index + 1) % eventDetails.length] },
  }));
}

interface Props {
  event: EventDetail;
  nextEvent: EventDetail;
}

const { event, nextEvent } = Astro.props;
---

<BaseLayout title={`${event.title} — MOSAÏQUE EVENTS`} description={event.description}>
  <Navigation surface="overlay" anchorPrefix="/" />
  <main class="event-detail" id="main-content" tabindex="-1" data-navigation-contrast="light">
    <div class="event-detail__chapter" data-content-status={event.status}>
      <EventHeader title={event.title} description={event.description} status={event.status} />
      <EventGallery
        featuredMedia={event.featuredMedia}
        images={event.gallery}
        slug={event.slug}
        title={event.title}
      />
    </div>
    <EventMoreGalleries event={nextEvent} />
  </main>
  <Footer anchorPrefix="/" />
</BaseLayout>
