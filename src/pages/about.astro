---
import AboutHero from "../components/about/AboutHero.astro";
import AboutMediaMosaic from "../components/about/AboutMediaMosaic.astro";
import PanelReveal from "../components/motion/PanelReveal.astro";
import Footer from "../components/sections/Footer.astro";
import Navigation from "../components/sections/Navigation.astro";
import { aboutPageContent } from "../content/about";
import BaseLayout from "../layouts/BaseLayout.astro";

import "../styles/sections/about-page.css";
---

<BaseLayout
  title={aboutPageContent.metadata.title}
  description={aboutPageContent.metadata.description}
  surface="cinematic"
>
  <Navigation anchorPrefix="/" />
  <main id="main-content">
    <PanelReveal class="about-page__reveal">
      <AboutHero slot="lead" {...aboutPageContent.hero} />
      <AboutMediaMosaic {...aboutPageContent.mosaic} />
    </PanelReveal>
  </main>
  <Footer />
</BaseLayout>
