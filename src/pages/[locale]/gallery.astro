---
import { prefixedLocales, type Locale } from "@/core/i18n";
import { getLocalizedEventGalleryItems } from "@/features/gallery";
import { galleryTranslations } from "@/features/gallery/i18n";
import GalleryPage from "@/features/gallery/ui/pages/GalleryPage.astro";

export function getStaticPaths() {
  return prefixedLocales.map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as Locale;
---

<GalleryPage
  title={`${galleryTranslations[locale].archiveTitle} — MOSAÏQUE EVENTS`}
  items={getLocalizedEventGalleryItems(locale)}
/>
