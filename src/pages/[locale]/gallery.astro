---
import { prefixedLocales, type Locale } from "@/core/i18n";
import { getPublication } from "@/features/publication/publication.mjs";
import { galleryTranslations } from "@/features/gallery/i18n";
import GalleryPage from "@/features/gallery/ui/pages/GalleryPage.astro";
export function getStaticPaths() {
  return prefixedLocales.map((locale) => ({ params: { locale } }));
}
const locale = Astro.params.locale as Locale;
const items = getPublication(locale).events;
const title = `${galleryTranslations[locale].archiveTitle} — MOSAÏQUE EVENTS`;
---

<GalleryPage {items} {title} />
