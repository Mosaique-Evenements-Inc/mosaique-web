---
import { prefixedLocales } from "@/core/i18n";
import { getEventSlugs } from "@/features/publication/publication.mjs";
import PublicationDetail from "@/features/publication/ui/PublicationDetail.astro";
export function getStaticPaths() {
  return prefixedLocales.flatMap((locale) =>
    getEventSlugs().map((slug) => ({
      params: { locale, slug },
    })),
  );
}
const slug = Astro.params.slug;
---

<PublicationDetail kind="event" slug={slug} />
