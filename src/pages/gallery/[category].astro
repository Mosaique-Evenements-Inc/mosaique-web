---
import { galleryCategories, getGalleryEvents } from "@/features/gallery";
import { getLocalizedEventCategory, type EventCategoryId } from "@/features/events";
import { galleryTranslations } from "@/features/gallery/i18n";
import GalleryPage from "@/features/gallery/ui/pages/GalleryPage.astro";

export function getStaticPaths() {
  return galleryCategories.map((category) => ({
    params: { category: category.id },
    props: { category },
  }));
}

const { category } = Astro.props;
const events = getGalleryEvents(category.id);
const localizedCategory = getLocalizedEventCategory(category.categoryId as EventCategoryId);
---

<GalleryPage
  activeCategoryId={category.id}
  items={events}
  title={`${localizedCategory.label} — ${galleryTranslations.es.archiveTitle} — MOSAÏQUE EVENTS`}
/>
