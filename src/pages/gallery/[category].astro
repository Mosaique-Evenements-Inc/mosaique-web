---
import { defaultLocale } from "@/core/i18n";
import { getGalleryCategoryIds, getPublication } from "@/features/publication/publication.mjs";
import { getLocalizedEventCategory, type EventCategoryId } from "@/features/events";
import { galleryTranslations } from "@/features/gallery/i18n";
import GalleryPage from "@/features/gallery/ui/pages/GalleryPage.astro";
export function getStaticPaths() {
  return getGalleryCategoryIds().map((category) => ({ params: { category } }));
}
const activeCategoryId = Astro.params.category;
const items = getPublication(defaultLocale).events.filter(
  (event) => event.categoryId === activeCategoryId,
);
const title = `${getLocalizedEventCategory(activeCategoryId as EventCategoryId, defaultLocale).label} — ${galleryTranslations[defaultLocale].archiveTitle} — MOSAÏQUE EVENTS`;
---

<GalleryPage {items} {title} {activeCategoryId} />
