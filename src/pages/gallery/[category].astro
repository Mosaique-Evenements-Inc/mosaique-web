---
import { getLocaleFromUrl } from "@/core/i18n";
import { getGalleryCategoryIds, getPublication } from "@/features/publication/publication";
import { getLocalizedEventCategory, type EventCategoryId } from "@/features/events";
import { galleryTranslations } from "@/features/gallery/i18n";
import GalleryPage from "@/features/gallery/ui/pages/GalleryPage.astro";
import NotFoundPage from "@/features/site-shell/ui/pages/NotFoundPage.astro";
const locale = getLocaleFromUrl(Astro.url);
const publication = getPublication(Astro.locals, locale);
const activeCategoryId = Astro.params.category;
const found =
  !!activeCategoryId && getGalleryCategoryIds(publication).includes(activeCategoryId);
if (!found) Astro.response.status = 404;
const items = publication.events.filter((event) => event.categoryId === activeCategoryId);
const title = found
  ? `${getLocalizedEventCategory(activeCategoryId as EventCategoryId, locale).label} — ${galleryTranslations[locale].archiveTitle} — MOSAÏQUE EVENTS`
  : "";
---

{found ? <GalleryPage {items} {title} {activeCategoryId} /> : <NotFoundPage />}
