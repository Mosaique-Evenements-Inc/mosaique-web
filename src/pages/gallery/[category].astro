---
import { galleryCategories, getGalleryEvents, type GalleryCategory } from "@/features/gallery";
import GalleryPage from "@/features/gallery/ui/pages/GalleryPage.astro";

export function getStaticPaths() {
  return galleryCategories.map((category) => ({
    params: { category: category.id },
    props: { category },
  }));
}

interface Props {
  category: GalleryCategory;
}

const { category } = Astro.props;
const events = getGalleryEvents(category.id);
---

<GalleryPage
  activeCategoryId={category.id}
  items={events}
  title={`${category.label} — Galería de eventos — MOSAÏQUE EVENTS`}
/>
