---
import { Picture } from "astro:assets";

import {
  eventImageFallbackFormat,
  eventImageFormats,
  eventImageWidths,
} from "../../assets/images/events/delivery";
import Icon from "../ui/Icon.astro";
import type { EventDetailImage } from "../../content/events";

interface Props {
  id: string;
  images: EventDetailImage[];
  title: string;
}

const { id, images, title } = Astro.props;
---

<dialog
  class="event-lightbox"
  id={id}
  data-event-lightbox
  aria-labelledby={`${id}-title`}
  aria-modal="true"
>
  <div class="event-lightbox__surface">
    <header class="event-lightbox__header">
      <h2 class="visually-hidden" id={`${id}-title`}>Galería ampliada de {title}</h2>
      <p data-event-lightbox-status aria-live="polite" aria-atomic="true"></p>
      <button type="button" data-event-lightbox-close aria-label="Cerrar galería ampliada">
        <Icon name="xmark" size={24} />
      </button>
    </header>

    <div class="event-lightbox__stage">
      {
        images.map((image, index) => (
          <figure
            class="event-lightbox__panel"
            data-event-lightbox-panel={index}
            data-active={index === 0 ? "true" : "false"}
            hidden={index !== 0}
          >
            {image.status === "approved" ? (
              <Picture
                src={image.src}
                alt={image.alt}
                formats={eventImageFormats}
                fallbackFormat={eventImageFallbackFormat}
                widths={eventImageWidths}
                sizes="100vw"
                loading="lazy"
                decoding="async"
              />
            ) : (
              <div
                class="event-lightbox__placeholder"
                data-tone={String((index % 6) + 1).padStart(2, "0")}
                style={`--event-lightbox-ratio:${image.width / image.height};aspect-ratio:${image.width} / ${image.height};`}
                role="img"
                aria-label={image.alt}
              >
                <span />
                <span />
              </div>
            )}
            <figcaption class="visually-hidden">{image.alt}</figcaption>
          </figure>
        ))
      }
    </div>

    <nav class="event-lightbox__controls" aria-label="Navegación de la galería ampliada">
      <button type="button" data-event-lightbox-previous aria-label="Imagen anterior">
        <Icon name="arrowLeft" size={22} />
        <span>Anterior</span>
      </button>
      <button type="button" data-event-lightbox-next aria-label="Imagen siguiente">
        <span>Siguiente</span>
        <Icon name="arrowRight" size={22} />
      </button>
    </nav>
  </div>
</dialog>

<script>
  document.querySelectorAll<HTMLDialogElement>("[data-event-lightbox]").forEach((dialog) => {
    if (dialog.dataset.ready === "true") return;
    dialog.dataset.ready = "true";

    const gallery = dialog.closest<HTMLElement>(".event-gallery");
    const triggers = Array.from(
      gallery?.querySelectorAll<HTMLButtonElement>("[data-event-lightbox-trigger]") ?? [],
    );
    const panels = Array.from(
      dialog.querySelectorAll<HTMLElement>("[data-event-lightbox-panel]"),
    );
    const closeButton = dialog.querySelector<HTMLButtonElement>("[data-event-lightbox-close]");
    const previousButton = dialog.querySelector<HTMLButtonElement>(
      "[data-event-lightbox-previous]",
    );
    const nextButton = dialog.querySelector<HTMLButtonElement>("[data-event-lightbox-next]");
    const status = dialog.querySelector<HTMLElement>("[data-event-lightbox-status]");
    const stage = dialog.querySelector<HTMLElement>(".event-lightbox__stage");
    const controller = new AbortController();
    let activeIndex = 0;
    let opener: HTMLButtonElement | null = null;
    let previousOverflow = "";

    const render = () => {
      panels.forEach((panel, index) => {
        const active = index === activeIndex;
        panel.hidden = !active;
        panel.dataset.active = String(active);
      });
      if (previousButton) previousButton.disabled = activeIndex === 0;
      if (nextButton) nextButton.disabled = activeIndex === panels.length - 1;
      if (status) status.textContent = `Imagen ${activeIndex + 1} de ${panels.length}`;
    };

    const open = (index: number, trigger: HTMLButtonElement) => {
      activeIndex = index;
      opener = trigger;
      previousOverflow = document.documentElement.style.overflow;
      document.documentElement.style.overflow = "hidden";
      render();
      dialog.showModal();
      closeButton?.focus();
    };

    const close = () => dialog.close();
    const goTo = (index: number) => {
      activeIndex = Math.min(Math.max(index, 0), panels.length - 1);
      render();
    };

    triggers.forEach((trigger, index) => {
      trigger.addEventListener("click", () => open(index, trigger), {
        signal: controller.signal,
      });
    });
    closeButton?.addEventListener("click", close, { signal: controller.signal });
    previousButton?.addEventListener("click", () => goTo(activeIndex - 1), {
      signal: controller.signal,
    });
    nextButton?.addEventListener("click", () => goTo(activeIndex + 1), {
      signal: controller.signal,
    });
    dialog.addEventListener(
      "click",
      (event) => {
        const target = event.target;
        if (
          target === dialog ||
          target === stage ||
          (target instanceof HTMLElement && target.matches("[data-event-lightbox-panel]"))
        ) {
          close();
        }
      },
      { signal: controller.signal },
    );
    dialog.addEventListener(
      "keydown",
      (event) => {
        if (event.key === "Escape") {
          event.preventDefault();
          close();
          return;
        }
        if (event.key === "ArrowLeft") goTo(activeIndex - 1);
        if (event.key === "ArrowRight") goTo(activeIndex + 1);
      },
      { signal: controller.signal },
    );
    dialog.addEventListener(
      "close",
      () => {
        document.documentElement.style.overflow = previousOverflow;
        opener?.focus();
        opener = null;
      },
      { signal: controller.signal },
    );
    window.addEventListener("pagehide", () => controller.abort(), {
      once: true,
      signal: controller.signal,
    });
  });
</script>
