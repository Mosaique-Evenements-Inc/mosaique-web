---
import Container from "../ui/Container.astro";
import Heading from "../ui/Heading.astro";
import Text from "../ui/Text.astro";

interface Props {
  description: string;
  status: "approved" | "placeholder";
  title: string;
}

const { description, status, title } = Astro.props;
---

<header class="event-header" data-content-status={status}>
  <Container>
    <div class="event-header__layout">
      <Heading as="h1" variant="display-lg">{title}</Heading>
      <Text variant="body-lg">{description}</Text>
    </div>
  </Container>
</header>
