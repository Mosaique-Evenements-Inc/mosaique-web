---
import Icon from "../ui/Icon.astro";
import Button from "../ui/Button";
---

<dialog class="venue-dialog" data-venue-dialog aria-labelledby="venue-dialog-title">
  <div class="venue-dialog__panel">
    <header>
      <div>
        <span>Detalles del espacio</span>
        <h2 id="venue-dialog-title">Cuéntanos sobre el venue</h2>
      </div>
      <button
        type="button"
        class="quote-close"
        data-venue-cancel
        aria-label="Cerrar detalles del venue"
      >
        <Icon name="xmark" size={22} />
      </button>
    </header>

    <div class="venue-dialog__body">
      <label class="quote-field">
        <span>Nombre del venue <strong aria-hidden="true">*</strong></span>
        <input
          type="text"
          name="venueNameDraft"
          aria-describedby="venue-name-error"
          data-error-required="Ingresa el nombre del venue."
        />
        <small id="venue-name-error" data-venue-name-error></small>
      </label>

      <div class="venue-upload">
        <div>
          <strong>Fotos del venue</strong>
          <p>Si las tienes, puedes compartir algunas fotos del espacio.</p>
        </div>
        <label class="venue-upload__dropzone" data-venue-dropzone>
          <input
            type="file"
            accept="image/jpeg,image/png,image/webp"
            multiple
            data-venue-files
          />
          <Icon name="upload" size={28} />
          <strong>Cargar fotos del venue</strong>
          <small>JPG · PNG · WEBP · Máximo 5</small>
        </label>
        <p class="venue-upload__notice">
          Las fotos se conservan como vista previa en esta página; el envío por correo actual no
          admite adjuntos.
        </p>
        <small data-venue-files-error></small>
        <div class="venue-upload__previews" data-venue-previews hidden></div>
        <p data-venue-files-count>0 de 5 fotos</p>
      </div>
    </div>

    <footer>
      <Button type="button" className="quote-button" data-venue-cancel> Cancelar </Button>
      <Button type="button" className="quote-button" data-venue-save variant="light">
        Guardar
      </Button>
    </footer>
  </div>
</dialog>
