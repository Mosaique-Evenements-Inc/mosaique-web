---
import { quoteContent } from "../../content/home/quote";
---

<section
  class="quote-step"
  data-quote-step="1"
  data-quote-tab-label={quoteContent.steps[1].label}
  aria-labelledby="quote-details-title"
  hidden
>
  <h2 class="visually-hidden" id="quote-details-title" tabindex="-1">
    {quoteContent.steps[1].label}
  </h2>

  <div class="quote-fields">
    <label class="quote-field quote-field--wide">
      <span>¿Ya tienes venue? <strong aria-hidden="true">*</strong></span>
      <select
        name="hasVenue"
        required
        aria-describedby="quote-venue-error"
        data-error-required="Selecciona una opción."
      >
        <option value="">Selecciona una opción</option>
        {
          quoteContent.venueOptions.map((option) => (
            <option value={option.value}>{option.label}</option>
          ))
        }
      </select>
      <small id="quote-venue-error" data-quote-error></small>
    </label>

    <div class="quote-venue-summary quote-field--wide" data-quote-venue-summary hidden>
      <div>
        <span>Venue guardado</span>
        <strong data-quote-venue-summary-name></strong>
        <small data-quote-venue-summary-photos></small>
      </div>
      <button type="button" class="quote-text-action" data-quote-venue-edit>Editar</button>
    </div>

    <label class="quote-field quote-field--wide">
      <span>Presupuesto estimado</span>
      <select name="budget">
        <option value="">Selecciona una opción (opcional)</option>
        {quoteContent.budgets.map((budget) => <option value={budget}>{budget}</option>)}
      </select>
    </label>

    <label class="quote-field quote-field--wide">
      <span>¿Qué tienes en mente?</span>
      <textarea
        name="message"
        rows="5"
        maxlength="500"
        placeholder="Cuéntanos brevemente sobre la experiencia, estilo o necesidades que tienes en mente."
        aria-describedby="quote-message-count"></textarea>
      <small id="quote-message-count" data-quote-message-count>0 / 500</small>
    </label>
  </div>
</section>
