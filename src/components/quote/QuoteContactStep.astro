---
import { quoteContent } from "../../content/home/quote";
---

<section class="quote-step__section" aria-labelledby="quote-contact-title">
  <header>
    <h3 id="quote-contact-title">Contacto</h3>
  </header>

  <div class="quote-fields">
    <label class="quote-field quote-field--wide">
      <span>Nombre completo <strong aria-hidden="true">*</strong></span>
      <input
        type="text"
        name="fullName"
        autocomplete="name"
        required
        aria-describedby="quote-full-name-error"
        data-error-required="Ingresa tu nombre completo."
      />
      <small id="quote-full-name-error" data-quote-error></small>
    </label>

    <label class="quote-field">
      <span>Email <strong aria-hidden="true">*</strong></span>
      <input
        type="email"
        name="email"
        autocomplete="email"
        required
        aria-describedby="quote-email-error"
        data-error-required="Ingresa tu email."
        data-error-invalid="Ingresa un email válido."
      />
      <small id="quote-email-error" data-quote-error></small>
    </label>

    <label class="quote-field">
      <span>Teléfono <strong aria-hidden="true">*</strong></span>
      <span class="quote-field__control">
        <input
          type="tel"
          name="phone"
          autocomplete="tel"
          inputmode="tel"
          maxlength="10"
          required
          aria-describedby="quote-phone-count quote-phone-error"
          data-error-required="Ingresa tu teléfono."
          data-error-invalid="Ingresa un teléfono válido."
        />
        <output
          id="quote-phone-count"
          class="quote-field__counter"
          data-quote-phone-count
          aria-live="polite">0 / 10</output
        >
      </span>
      <small id="quote-phone-error" data-quote-error></small>
    </label>

    <label class="quote-field quote-field--wide">
      <span>Idioma de preferencia</span>
      <select name="preferredLanguage">
        <option value="">Sin preferencia</option>
        {
          quoteContent.preferredLanguages.map((language) => (
            <option value={language.value}>{language.label}</option>
          ))
        }
      </select>
      <small data-quote-error></small>
    </label>
  </div>
</section>
