---
import { servicesContent } from "../../content/home/services";
import Heading from "../ui/Heading.astro";
import Text from "../ui/Text.astro";
import HomeServicePreviewScene from "./HomeServicePreviewScene.astro";

import "../../styles/sections/home-services-showcase.css";

const services = [...servicesContent.items].sort((a, b) => a.index.localeCompare(b.index));
const titleId = "home-services-heading";
---

<section
  class="home-services-showcase"
  id="services"
  aria-labelledby={titleId}
  data-navigation-contrast="light"
>
  <header class="home-services-showcase__intro">
    <div class="home-services-showcase__intro-inner">
      <Heading as="h2" variant="display-xl" id={titleId}>
        {servicesContent.panelReveal.title}
      </Heading>
      <Text variant="body-lg" tone="inverse">
        {servicesContent.panelReveal.text}
      </Text>
      <a class="home-services-showcase__intro-cta" href="#services-list">
        {servicesContent.panelReveal.cta.label}
      </a>
    </div>
  </header>

  <div class="home-services-showcase__sequence" id="services-list">
    {
      services.map((service, index) => (
        <HomeServicePreviewScene
          service={service}
          sceneIndex={index}
          isLast={index === services.length - 1}
        />
      ))
    }
  </div>
</section>
