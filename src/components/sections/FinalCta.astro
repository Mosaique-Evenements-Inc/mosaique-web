---
import EditorialAction from "../ui/EditorialAction";
import Container from "../ui/Container.astro";
import Heading from "../ui/Heading.astro";
import Text from "../ui/Text.astro";
import { finalCtaContent } from "../../content/home/finalCta";

import "../../styles/sections/final-cta.css";

const galleryTones = ["01", "02", "03", "04", "05"] as const;
---

<section class="final-cta" id="contact" aria-labelledby="final-cta-title">
  <div class="final-cta__stage" data-final-cta-interactive data-navigation-contrast="light">
    <div class="final-cta__dots-interactive" aria-hidden="true"></div>
    <Container class="final-cta__container">
      <div class="final-cta__content">
        <Heading as="h2" variant="heading-lg" id="final-cta-title">
          {finalCtaContent.title}
        </Heading>

        <Text>{finalCtaContent.text}</Text>

        <div class="final-cta__actions">
          <EditorialAction
            className="final-cta__action final-cta__action--primary"
            href={finalCtaContent.action.href}
            data-quote-trigger
          >
            {finalCtaContent.action.label}
          </EditorialAction>
        </div>
      </div>
    </Container>
  </div>

  <div
    class="final-cta__gallery"
    data-media-status="pending"
    data-navigation-contrast="dark"
    aria-hidden="true"
  >
    <div class="final-cta__track">
      {
        [false, true].map((duplicate) => (
          <div class="final-cta__group" data-duplicate={duplicate ? "true" : undefined}>
            {galleryTones.map((tone) => (
              <figure class="final-cta__media" data-tone={tone}>
                <span />
                <span />
              </figure>
            ))}
          </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  const interactiveCta = document.querySelector<HTMLElement>("[data-final-cta-interactive]");

  if (interactiveCta && interactiveCta.dataset.ready !== "true") {
    interactiveCta.dataset.ready = "true";
    const finePointer = window.matchMedia("(hover: hover) and (pointer: fine)");
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    const controller = new AbortController();
    let bounds: DOMRect | null = null;
    let pointerX = 0.5;
    let pointerY = 0.5;
    let frame = 0;

    const renderPointer = () => {
      frame = 0;
      interactiveCta.style.setProperty("--cta-pointer-x", `${pointerX * 100}%`);
      interactiveCta.style.setProperty("--cta-pointer-y", `${pointerY * 100}%`);
      interactiveCta.style.setProperty("--cta-shift-x", `${(pointerX - 0.5) * 8}px`);
      interactiveCta.style.setProperty("--cta-shift-y", `${(pointerY - 0.5) * 6}px`);
    };

    const schedulePointer = () => {
      if (!frame) frame = requestAnimationFrame(renderPointer);
    };

    interactiveCta.addEventListener(
      "pointerenter",
      () => {
        if (!finePointer.matches || reducedMotion.matches) return;
        bounds = interactiveCta.getBoundingClientRect();
        interactiveCta.dataset.pointerActive = "true";
      },
      { signal: controller.signal },
    );

    interactiveCta.addEventListener(
      "pointermove",
      (event) => {
        if (!finePointer.matches || reducedMotion.matches || !bounds) return;
        pointerX = Math.min(1, Math.max(0, (event.clientX - bounds.left) / bounds.width));
        pointerY = Math.min(1, Math.max(0, (event.clientY - bounds.top) / bounds.height));
        schedulePointer();
      },
      { passive: true, signal: controller.signal },
    );

    interactiveCta.addEventListener(
      "pointerleave",
      () => {
        bounds = null;
        pointerX = 0.5;
        pointerY = 0.5;
        interactiveCta.dataset.pointerActive = "false";
        schedulePointer();
      },
      { signal: controller.signal },
    );

    window.addEventListener(
      "resize",
      () => {
        bounds = null;
      },
      { passive: true, signal: controller.signal },
    );

    document.addEventListener(
      "astro:before-swap",
      () => {
        controller.abort();
        if (frame) cancelAnimationFrame(frame);
      },
      { once: true },
    );
  }
</script>
