---
import Button from "../ui/Button";
import Heading from "../ui/Heading.astro";
import Text from "../ui/Text.astro";
import type { Service } from "../../content/services";

interface Props {
  service: Service;
}

const { service } = Astro.props;
---

<header class="service-header" data-content-status="placeholder">
  <div class="service-header__layout">
    <Heading as="h1" variant="display-lg">{service.title}</Heading>

    <div class="service-header__narrative">
      <Text variant="body-lg" tone="inverse">{service.description}</Text>
      <Button className="service-header__cta" href={service.cta.href} variant="light">
        {service.cta.label}
      </Button>
    </div>

    <div class="service-header__divider" aria-hidden="true"></div>
  </div>
</header>
