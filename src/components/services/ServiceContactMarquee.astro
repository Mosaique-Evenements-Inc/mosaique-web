---
import { finalCtaContent } from "../../content/home/finalCta";

const marqueeItems = Array.from({ length: 3 }, () => finalCtaContent.action.label);
---

<section
  class="service-contact-marquee"
  aria-labelledby="service-contact-marquee-title"
  data-navigation-contrast="light"
>
  <h2 id="service-contact-marquee-title" class="sr-only">{finalCtaContent.action.label}</h2>

  <a
    class="service-contact-marquee__link"
    href={finalCtaContent.action.href}
    aria-label={finalCtaContent.action.label}
  >
    <p class="service-contact-marquee__lead">{finalCtaContent.text}</p>

    <span class="service-contact-marquee__viewport" aria-hidden="true">
      <span class="service-contact-marquee__track">
        {
          [false, true].map((duplicate) => (
            <span
              class="service-contact-marquee__group"
              data-duplicate={duplicate ? "true" : undefined}
            >
              {marqueeItems.map((label) => (
                <span>{label}</span>
              ))}
            </span>
          ))
        }
      </span>
    </span>
  </a>
</section>
