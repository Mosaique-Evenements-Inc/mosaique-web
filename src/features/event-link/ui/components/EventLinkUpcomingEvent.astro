---
import { Image, Picture } from "astro:assets";
import type { ImageMetadata } from "astro";

import { eventImageFallbackFormat, eventImageFormats } from "@/assets/images/events/delivery";
import Icon from "@/core/common/ui/components/Icon.astro";
import type { EventLinkUpcomingView, ShareActionLabels, SharePayload } from "../../types";
import ShareAction from "./ShareAction.astro";

interface Props {
  event: EventLinkUpcomingView;
  sharePayload: SharePayload;
  shareLabel: string;
  shareLabels: ShareActionLabels;
  logo: ImageMetadata;
}

const { event, sharePayload, shareLabel, shareLabels, logo } = Astro.props;
---

<details class="event-link-upcoming">
  <summary class="event-link-upcoming__summary">
    <span class="event-link-upcoming__logo" aria-hidden="true">
      <Image src={logo} alt="" width={logo.width} height={logo.height} loading="lazy" />
    </span>
    <span class="event-link-upcoming__summary-copy">
      <strong>{event.title}</strong>
      <span>
        {event.location.venue}<span> · </span><time datetime={event.date}
          >{event.dateLabel}</time
        ><span> · </span><time datetime={event.startTime}>{event.timeLabel}</time>
      </span>
    </span>
    <span class="event-link-upcoming__chevron" aria-hidden="true">
      <Icon name="navArrowDown" size={20} />
    </span>
  </summary>
  <div class="event-link-upcoming__expanded">
    {
      event.image && (
        <div class="event-link-upcoming__visual">
          <Picture
            src={event.image.src}
            alt={event.image.alt}
            formats={eventImageFormats}
            fallbackFormat={eventImageFallbackFormat}
            widths={[320, 480, 640, 960, 1200]}
            sizes="(max-width: 640px) calc(100vw - 4rem), 560px"
            width={event.image.src.width}
            height={event.image.src.height}
            loading="lazy"
            decoding="async"
          />
        </div>
      )
    }
    <div class="event-link-upcoming__body">
      <p class="event-link-upcoming__eyebrow">{event.categoryLabel}</p>
      <h3 class="event-link-upcoming__title">{event.title}</h3>
      <p class="event-link-upcoming__description">{event.description}</p>

      <div class="event-link-upcoming__details">
        <div class="event-link-upcoming__detail">
          <Icon name="calendar" size={22} />
          <p>
            <time datetime={event.date}>{event.dateLabel}</time>
            <span aria-hidden="true"> · </span>
            <time datetime={event.startTime}>{event.timeLabel}</time>
          </p>
        </div>
        <div class="event-link-upcoming__detail">
          <Icon name="mapPin" size={22} />
          <p>
            {event.location.venue}<span class="event-link-upcoming__city"
              >{event.location.city}</span
            >
          </p>
        </div>
      </div>

      <div class="event-link-upcoming__actions">
        <a
          class="event-link-upcoming__ticket"
          href={event.ticketUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          <span>{event.ticketLabel}</span>
          <Icon name="arrowRight" size={22} />
          <span class="visually-hidden"> ({event.opensNewTab})</span>
        </a>
        <ShareAction
          instanceId="share-upcoming-event"
          payload={sharePayload}
          triggerLabel={shareLabel}
          labels={shareLabels}
          preview={{
            logo,
            title: event.title,
            category: event.categoryLabel,
            dateLabel: event.dateLabel,
            timeLabel: event.timeLabel,
            venue: event.location.venue,
            city: event.location.city,
            destinationLabel: event.ticketLabel,
          }}
          iconOnly
        />
      </div>
    </div>
  </div>
</details>
