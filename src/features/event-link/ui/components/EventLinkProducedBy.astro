---
import { Image } from "astro:assets";
import Icon from "@/core/common/ui/components/Icon.astro";
import { getLocalizedHref, type Locale } from "@/core/i18n";
import { footerContent } from "@/features/site-shell/content/footer";
import { eventLinkLogoAssets } from "../../data/logo-assets";
import type { EventLinkProducerView } from "../../types";

interface Props {
  producer: EventLinkProducerView;
  locale: Locale;
}

const { producer, locale } = Astro.props;
const logo = eventLinkLogoAssets[producer.logoAssetId];
---

<footer class="event-link-produced-by">
  <a class="event-link-produced-by__link" href={getLocalizedHref(producer.href, locale)}>
    <span class="event-link-produced-by__label">{producer.label}</span>
    <span class="event-link-produced-by__logo">
      <Image src={logo} alt="" width={330} format="webp" loading="lazy" decoding="async" />
    </span>
  </a>
  <p class="event-link-produced-by__location">
    <Icon name="mapPin" size={13} />{footerContent.contact.location}
  </p>
</footer>
