---
import Icon from "@/core/common/ui/components/Icon.astro";

interface Props {
  href: string;
  label: string;
  accessibleName?: string;
}

const { href, label, accessibleName } = Astro.props;
---

<a class="event-link-menu-entry" {href} aria-label={accessibleName}>
  <span class="event-link-menu-entry__icon" aria-hidden="true">
    <Icon name="cutlery" size={22} />
  </span>
  <span class="event-link-menu-entry__label">{label}</span>
  <span class="event-link-menu-entry__arrow"><Icon name="arrowRight" size={20} /></span>
</a>
