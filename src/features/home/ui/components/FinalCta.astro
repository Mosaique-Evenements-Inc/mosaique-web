---
import { Picture } from "astro:assets";
import { eventImageFormats, eventImageFallbackFormat } from "@/assets/images/events/delivery";
import { finalCtaGalleryImages } from "@/features/home/content/final-cta-gallery";
import Button from "@/core/common/ui/components/Button";
import Container from "@/core/common/ui/components/Container.astro";
import Heading from "@/core/common/ui/components/Heading.astro";
import Text from "@/core/common/ui/components/Text.astro";
import CursorHalftone from "./CursorHalftone.astro";
import { finalCtaContent } from "@/features/quote/content/finalCta";
import { getHomeTranslations } from "@/features/home/i18n";
import { getLocalizedHref, getLocaleFromUrl } from "@/core/i18n";

import "@/features/home/ui/styles/final-cta.css";

const locale = getLocaleFromUrl(Astro.url);
const finalCtaText = getHomeTranslations(locale);
---

<section class="final-cta" id="contact" aria-labelledby="final-cta-title">
  <div
    class="final-cta__stage cursor-halftone"
    data-cursor-halftone
    data-navigation-contrast="light"
  >
    <CursorHalftone />
    <Container class="final-cta__container">
      <div class="final-cta__content">
        <Heading as="h2" variant="heading-lg" id="final-cta-title">
          {finalCtaText.finalCtaTitle}
        </Heading>

        <Text>{finalCtaText.finalCtaText}</Text>

        <div class="final-cta__actions">
          <Button
            className="final-cta__action final-cta__action--primary"
            href={getLocalizedHref(finalCtaContent.action.href, locale)}
            variant="light"
          >
            {finalCtaText.finalCtaAction}
          </Button>
        </div>
      </div>
    </Container>
  </div>

  <div
    class="final-cta__gallery"
    data-media-status="approved"
    data-navigation-contrast="dark"
    aria-hidden="true"
  >
    <div class="final-cta__track">
      {
        [false, true].map((duplicate) => (
          <div class="final-cta__group" data-duplicate={duplicate ? "true" : undefined}>
            {finalCtaGalleryImages.map((src) => (
              <figure class="final-cta__media">
                <Picture
                  src={src}
                  alt=""
                  formats={eventImageFormats}
                  fallbackFormat={eventImageFallbackFormat}
                  width={360}
                  height={640}
                  widths={[180, 360, 540]}
                  sizes="246px"
                  fit="cover"
                  loading="eager"
                  decoding="async"
                />
              </figure>
            ))}
          </div>
        ))
      }
    </div>
  </div>
</section>
