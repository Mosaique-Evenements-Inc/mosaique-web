---
import { Picture } from "astro:assets";

import {
  eventImageFallbackFormat,
  eventImageFormats,
  eventImageWidths,
} from "@/assets/images/events/delivery";
import { marqueeContent } from "@/features/home/content/marquee";
import { getHomeTranslations } from "@/features/home/i18n";
import { getHomeContentTranslations } from "@/features/home/i18n";
import { getLocaleFromUrl } from "@/core/i18n";

import "@/features/home/ui/styles/marquee.css";

const locale = getLocaleFromUrl(Astro.url);
const homeText = getHomeTranslations(locale);
const marqueeContentText = getHomeContentTranslations(locale);
const marqueeText = marqueeContentText.marqueeOptions[0];
const marqueeStatement = marqueeContentText.marqueeOptions[2];
---

<section
  class="marquee"
  aria-label={homeText.servicesAndExperiences}
  data-navigation-contrast="light"
>
  <div class="marquee__scene">
    <figure
      class="marquee__media"
      data-media-status={marqueeContent.media.status}
      aria-hidden="true"
    >
      <Picture
        src={marqueeContent.media.src}
        alt=""
        formats={eventImageFormats}
        fallbackFormat={eventImageFallbackFormat}
        widths={eventImageWidths}
        sizes="100vw"
        loading="lazy"
        decoding="async"
      />
    </figure>

    <div class="marquee__curtain" aria-hidden="true">
      <span></span>
      <span></span>
      <span></span>
    </div>

    <div class="marquee__intro">
      <p class="marquee__eyebrow">MOSAÏQUE EVENTS</p>
      <p>{marqueeStatement}</p>
    </div>

    <div class="marquee__viewport">
      <div class="marquee__track">
        <p class="marquee__group">{marqueeText}</p>
        <p class="marquee__group" aria-hidden="true">{marqueeText}</p>
      </div>
    </div>
  </div>
</section>

<script>
  const clamp = (value: number) => Math.min(Math.max(value, 0), 1);
  const smoothstep = (value: number) => value * value * (3 - 2 * value);

  const depthMotion = {
    progressStart: 0.06,
    progressEnd: 0.94,
    desktop: {
      scaleStart: 1,
      scaleEnd: 1.18,
      translateYStart: 0,
      translateYEnd: -1.5,
    },
    compact: {
      scaleStart: 1,
      scaleEnd: 1.1,
      translateYStart: 0,
      translateYEnd: -0.75,
    },
  } as const;

  const revealMotion = {
    desktop: {
      preEntryDistance: 0.12,
      revealDistance: 1.38,
      postStickyDistance: 0.5,
      curtainDelays: [0.28, 0.14, 0],
    },
    compact: {
      preEntryDistance: 0.08,
      revealDistance: 1.07,
      postStickyDistance: 0.15,
      curtainDelays: [0.18, 0.09, 0],
    },
  } as const;

  const interpolate = (start: number, end: number, progress: number) =>
    start + (end - start) * progress;

  document.querySelectorAll<HTMLElement>(".marquee").forEach((section) => {
    if (section.dataset.motionReady === "true") return;

    section.dataset.motionReady = "true";

    const scene = section.querySelector<HTMLElement>(".marquee__scene");
    const depthTarget = section.querySelector<HTMLElement>(".marquee__media img");
    const track = section.querySelector<HTMLElement>(".marquee__track");
    const intro = section.querySelector<HTMLElement>(".marquee__intro");
    const curtainPanels = Array.from(
      section.querySelectorAll<HTMLElement>(".marquee__curtain span"),
    );
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

    if (!scene || !depthTarget || !track || !intro) return;

    let motionAllowed = !reducedMotion.matches;
    let depthConfig = window.innerWidth < 768 ? depthMotion.compact : depthMotion.desktop;
    let revealConfig = window.innerWidth < 768 ? revealMotion.compact : revealMotion.desktop;

    let frameId = 0;
    let isNearby = false;
    let isListening = false;

    const render = () => {
      frameId = 0;

      if (!isNearby || !motionAllowed) return;

      const rect = section.getBoundingClientRect();
      const scrollRange = Math.max(section.offsetHeight - window.innerHeight, 1);
      const postRevealScroll = -rect.top - window.innerHeight * revealConfig.postStickyDistance;
      const existingMotionRange = Math.max(
        scrollRange - window.innerHeight * revealConfig.postStickyDistance,
        1,
      );
      const pinnedProgress = clamp(postRevealScroll / existingMotionRange);
      const depthProgress = clamp(
        (pinnedProgress - depthMotion.progressStart) /
          (depthMotion.progressEnd - depthMotion.progressStart),
      );
      const easedDepthProgress = smoothstep(depthProgress);
      const depthScale = interpolate(
        depthConfig.scaleStart,
        depthConfig.scaleEnd,
        easedDepthProgress,
      );
      const depthTranslateY = interpolate(
        depthConfig.translateYStart,
        depthConfig.translateYEnd,
        easedDepthProgress,
      );
      const revealProgress = clamp(
        (window.innerHeight - rect.top - window.innerHeight * revealConfig.preEntryDistance) /
          (window.innerHeight * revealConfig.revealDistance),
      );
      const introOpacity = clamp(pinnedProgress / 0.08);
      const tickerOpacity = clamp(pinnedProgress / 0.1);

      curtainPanels.forEach((panel, index) => {
        const delay = revealConfig.curtainDelays[index] ?? 0;
        const panelProgress = clamp((revealProgress - delay) / (1 - delay));
        panel.style.transform = `translate3d(0, ${-panelProgress * 100}%, 0)`;
      });

      depthTarget.style.transform = `translate3d(0, ${depthTranslateY}%, 0) scale(${depthScale})`;
      intro.style.opacity = String(introOpacity);
      track.style.opacity = String(tickerOpacity);
    };

    const scheduleRender = () => {
      if (!frameId) frameId = window.requestAnimationFrame(render);
    };

    const setScrollListener = (shouldListen: boolean) => {
      if (shouldListen === isListening) return;

      isListening = shouldListen;

      if (shouldListen) {
        window.addEventListener("scroll", scheduleRender, { passive: true });
      } else {
        window.removeEventListener("scroll", scheduleRender);
      }
    };

    const resetMotionStyles = () => {
      depthTarget.style.removeProperty("transform");
      intro.style.removeProperty("opacity");
      track.style.removeProperty("opacity");
      curtainPanels.forEach((panel) => panel.style.removeProperty("transform"));
    };

    const syncMotionPreference = () => {
      motionAllowed = !reducedMotion.matches;
      section.classList.toggle("is-enhanced", motionAllowed);
      section.classList.toggle("is-nearby", motionAllowed && isNearby);
      setScrollListener(motionAllowed && isNearby);

      if (motionAllowed) {
        scheduleRender();
      } else {
        resetMotionStyles();
      }
    };

    const observer = new IntersectionObserver(
      ([entry]) => {
        isNearby = entry?.isIntersecting ?? false;
        section.classList.toggle("is-nearby", isNearby && motionAllowed);
        setScrollListener(isNearby && motionAllowed);
        if (isNearby && motionAllowed) scheduleRender();
      },
      { rootMargin: "100% 0px" },
    );
    const resizeObserver = new ResizeObserver(() => {
      depthConfig = window.innerWidth < 768 ? depthMotion.compact : depthMotion.desktop;
      revealConfig = window.innerWidth < 768 ? revealMotion.compact : revealMotion.desktop;
      scheduleRender();
    });

    observer.observe(section);
    resizeObserver.observe(scene);
    reducedMotion.addEventListener("change", syncMotionPreference);
    syncMotionPreference();

    window.addEventListener(
      "pagehide",
      () => {
        observer.disconnect();
        resizeObserver.disconnect();
        reducedMotion.removeEventListener("change", syncMotionPreference);
        setScrollListener(false);
        if (frameId) window.cancelAnimationFrame(frameId);
      },
      { once: true },
    );
  });
</script>
