---
import { Picture } from "astro:assets";

import {
  eventImageFallbackFormat,
  eventImageFormats,
  eventImageWidths,
} from "@/assets/images/events/delivery";
import type { Service } from "@/features/services";
import Button from "@/core/common/ui/components/Button";
import Heading from "@/core/common/ui/components/Heading.astro";
import Text from "@/core/common/ui/components/Text.astro";
import { getHomeTranslations } from "@/features/home/i18n";
import { getLocalizedHref, getLocaleFromUrl } from "@/core/i18n";

interface Props {
  isLast: boolean;
  sceneIndex: number;
  service: Service;
}

const { isLast, sceneIndex, service } = Astro.props;
const media = service.featuredMedia;
const locale = getLocaleFromUrl(Astro.url);
const detailHref = getLocalizedHref(`/services/${service.slug}`, locale);
const homeText = getHomeTranslations(locale);
---

<article
  class:list={["home-service-preview", { "is-last": isLast }]}
  data-content-status={media.status}
  style={`--home-service-scene-index: ${sceneIndex + 1}`}
  aria-labelledby={`home-service-title-${service.id}`}
>
  <div class="home-service-preview__surface">
    <div class="home-service-preview__media" aria-hidden="true">
      <div class="home-service-preview__media-inner">
        {
          media.kind === "image" ? (
            <Picture
              src={media.src}
              alt=""
              formats={eventImageFormats}
              fallbackFormat={eventImageFallbackFormat}
              widths={eventImageWidths}
              sizes="100vw"
              loading="lazy"
              decoding="async"
            />
          ) : media.kind === "video" ? (
            <video
              src={media.src}
              poster={media.poster}
              muted
              playsinline
              preload="metadata"
              tabindex="-1"
            />
          ) : (
            <span class="home-service-preview__placeholder" data-tone={service.index}>
              <span />
              <span />
            </span>
          )
        }
        <span class="home-service-preview__overlay"></span>
      </div>
    </div>

    <div class="home-service-preview__copy">
      <Text as="span" variant="caption" tone="inverse" class="home-service-preview__label">
        {homeText.service}
        {service.index}
      </Text>
      <Heading as="h3" variant="display-lg" id={`home-service-title-${service.id}`}>
        {service.title}
      </Heading>
      <Text variant="body-lg" tone="inverse" class="home-service-preview__description">
        {service.description}
      </Text>
      <Text tone="inverse" class="home-service-preview__ideal-for">
        <strong>{homeText.idealFor}</strong>{" "}{service.idealFor}
      </Text>
      <div class="home-service-preview__actions">
        <Button href={detailHref} variant="transparent">{homeText.viewMore}</Button>
        <Button href={getLocalizedHref(service.cta.href, locale)} variant="light">
          {homeText.quoteEvent}
        </Button>
      </div>
    </div>
  </div>
</article>
