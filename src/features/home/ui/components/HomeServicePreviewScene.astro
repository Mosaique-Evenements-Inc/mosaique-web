---
import type { CmsItem } from "@/features/publication/publication";
import PublicationImage from "@/features/publication/ui/PublicationImage.astro";
import Button from "@/core/common/ui/components/Button";
import Heading from "@/core/common/ui/components/Heading.astro";
import Text from "@/core/common/ui/components/Text.astro";
import { getHomeTranslations } from "@/features/home/i18n";
import { getLocalizedHref, getLocaleFromUrl } from "@/core/i18n";

interface Props {
  isLast: boolean;
  sceneIndex: number;
  service: CmsItem;
}

const { isLast, sceneIndex, service } = Astro.props;
const media = service.mainImage;
const locale = getLocaleFromUrl(Astro.url);
const detailHref = getLocalizedHref(`/services/${service.slug}`, locale);
const homeText = getHomeTranslations(locale);
---

<article
  class:list={["home-service-preview", { "is-last": isLast }]}
  data-content-status="published"
  style={`--home-service-scene-index: ${sceneIndex + 1}`}
  aria-labelledby={`home-service-title-${service.code}`}
>
  <div class="home-service-preview__surface">
    <div class="home-service-preview__media">
      <div class="home-service-preview__media-inner">
        <PublicationImage media={media} sizes="100vw" loading="lazy" />
        <span class="home-service-preview__overlay" aria-hidden="true"></span>
      </div>
    </div>

    <div class="home-service-preview__copy">
      <Text as="span" variant="caption" tone="inverse" class="home-service-preview__label">
        {homeText.service}
        {String(sceneIndex + 1).padStart(2, "0")}
      </Text>
      <Heading as="h3" variant="display-lg" id={`home-service-title-${service.code}`}>
        {service.title}
      </Heading>
      <Text variant="body-lg" tone="inverse" class="home-service-preview__description">
        {service.description}
      </Text>
      <Text tone="inverse" class="home-service-preview__ideal-for">
        <strong>{homeText.idealFor}</strong>{" "}{service.idealFor}
      </Text>
      <div class="home-service-preview__actions">
        <Button href={detailHref} variant="transparent">{homeText.viewMore}</Button>
        <Button
          href={getLocalizedHref(`/contact?service=${service.slug}`, locale)}
          variant="light"
        >
          {homeText.quoteEvent}
        </Button>
      </div>
    </div>
  </div>
</article>
