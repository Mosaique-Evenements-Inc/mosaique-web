---
import Heading from "@/core/common/ui/components/Heading.astro";
import Text from "@/core/common/ui/components/Text.astro";
import HomeServicePreviewScene from "./HomeServicePreviewScene.astro";
import CursorHalftone from "./CursorHalftone.astro";
import { getLocaleFromUrl } from "@/core/i18n";
import { getPublication } from "@/features/publication/publication.mjs";

import "@/features/home/ui/styles/home-services-showcase.css";

const locale = getLocaleFromUrl(Astro.url);
const publication = getPublication(locale);
const services = [...publication.services].sort(
  (a, b) => a.order - b.order || a.code.localeCompare(b.code),
);
const titleId = "home-services-heading";
const servicesPanel = {
  title: publication.home.servicesTitle,
  text: publication.home.servicesText,
};
---

<section
  class="home-services-showcase"
  id="services"
  aria-labelledby={titleId}
  data-navigation-contrast="light"
>
  <header class="home-services-showcase__intro cursor-halftone" data-cursor-halftone>
    <CursorHalftone />
    <div class="home-services-showcase__intro-inner">
      <Heading as="h2" variant="display-xl" id={titleId}>
        {servicesPanel.title}
      </Heading>
      <Text variant="body-lg" tone="inverse">
        {servicesPanel.text}
      </Text>
    </div>
  </header>

  <div class="home-services-showcase__sequence" id="services-list">
    {
      services.map((service, index) => (
        <HomeServicePreviewScene
          service={service}
          sceneIndex={index}
          isLast={index === services.length - 1}
        />
      ))
    }
  </div>
</section>
