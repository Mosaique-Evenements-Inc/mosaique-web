---
import Button from "@/core/common/ui/components/Button";
import Container from "@/core/common/ui/components/Container.astro";
import Heading from "@/core/common/ui/components/Heading.astro";
import { heroContent } from "@/features/home/content/hero";
import { getHomeContentTranslations, getHomeTranslations } from "@/features/home/i18n";
import { getLocalizedHref, getLocaleFromUrl } from "@/core/i18n";

import "@/features/site-shell/ui/styles/home-entry.css";

const locale = getLocaleFromUrl(Astro.url);
const homeText = getHomeTranslations(locale);
const heroText = getHomeContentTranslations(locale);
---

<section
  class="home-hero"
  id="top"
  aria-labelledby="home-hero-title"
  data-navigation-contrast="light"
>
  <div class="home-hero__scene">
    <figure
      class="home-hero__media"
      data-media-status={heroContent.media.status}
      style={`--home-hero-media-position:${heroContent.media.position};`}
    >
      <img
        class="home-hero__poster"
        src={heroContent.media.poster}
        srcset={`${heroContent.media.posterSmall} 960w, ${heroContent.media.poster} 1920w`}
        sizes="100vw"
        width="1920"
        height="1080"
        alt=""
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
      <video muted loop playsinline preload="none" aria-hidden="true">
        {
          heroContent.media.sources.map((source) => (
            <source src={source.src} type={source.type} />
          ))
        }
      </video>
      <figcaption>{homeText.heroOverlay}</figcaption>
    </figure>

    <Container class="home-hero__stage">
      <div class="home-hero__final-state">
        <Heading as="h1" variant="heading-lg" class="home-hero__title" id="home-hero-title">
          {
            heroText.heroSegments.map((segment) =>
              segment.emphasis ? <em>{segment.text}</em> : segment.text,
            )
          }
        </Heading>
        <Button
          className="home-hero__primary-action"
          href={getLocalizedHref(heroContent.actions.primary.href, locale)}
        >
          {homeText.planEvent}
        </Button>
      </div>
    </Container>
  </div>
</section>

<script>
  const clamp = (value: number) => Math.min(Math.max(value, 0), 1);
  const rangeProgress = (progress: number, start: number, end: number) =>
    clamp((progress - start) / (end - start));

  document.querySelectorAll<HTMLElement>(".home-hero").forEach((hero) => {
    if (hero.dataset.scrollMotionReady === "true") return;

    hero.dataset.scrollMotionReady = "true";

    const scrollOrigin = hero.closest<HTMLElement>(".panel-reveal") ?? hero;
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    const poster = hero.querySelector<HTMLImageElement>(".home-hero__poster");
    const video = hero.querySelector<HTMLVideoElement>("video");
    const connection = (
      navigator as Navigator & {
        connection?: { saveData?: boolean; effectiveType?: string; downlink?: number };
      }
    ).connection;
    const controller = new AbortController();
    let heroTop = scrollOrigin.getBoundingClientRect().top + window.scrollY;
    let frameId = 0;

    const update = () => {
      frameId = 0;

      if (reducedMotion.matches) {
        hero.style.setProperty("--hero-caption-opacity", "1");
        return;
      }

      const scrollRange = Math.max(window.innerHeight * 0.55, 1);
      const progress = clamp((window.scrollY - heroTop) / scrollRange);
      const captionProgress = rangeProgress(progress, 0.64, 0.88);

      hero.style.setProperty("--hero-caption-opacity", String(captionProgress));
    };

    const requestUpdate = () => {
      if (!frameId) frameId = window.requestAnimationFrame(update);
    };

    const handleResize = () => {
      heroTop = scrollOrigin.getBoundingClientRect().top + window.scrollY;
      requestUpdate();
    };

    let posterReady = false;
    let videoStartQueued = false;
    const canPlayVideo = () =>
      !reducedMotion.matches &&
      !document.hidden &&
      !connection?.saveData &&
      (connection?.downlink === undefined || connection.downlink >= 10) &&
      !["slow-2g", "2g", "3g"].includes(connection?.effectiveType ?? "");

    const startVideo = () => {
      if (!video || !posterReady || videoStartQueued || !canPlayVideo()) return;
      videoStartQueued = true;
      window.requestAnimationFrame(() => {
        window.requestAnimationFrame(() => {
          videoStartQueued = false;
          if (canPlayVideo()) void video.play().catch(() => {});
        });
      });
    };

    const syncVideo = () => {
      if (!video) return;
      if (canPlayVideo()) startVideo();
      else video.pause();
    };

    if (poster && video) {
      const onPosterReady = async () => {
        try {
          if (poster.naturalWidth) await poster.decode();
        } catch {
          // A failed poster still allows the video to recover the visual.
        }
        posterReady = true;
        startVideo();
      };

      if (poster.complete) void onPosterReady();
      else {
        poster.addEventListener("load", onPosterReady, {
          once: true,
          signal: controller.signal,
        });
        poster.addEventListener("error", onPosterReady, {
          once: true,
          signal: controller.signal,
        });
      }

      video.addEventListener(
        "playing",
        () => {
          hero.dataset.videoPlaying = "true";
        },
        { signal: controller.signal },
      );
      video.addEventListener(
        "pause",
        () => {
          hero.dataset.videoPlaying = "false";
        },
        { signal: controller.signal },
      );
      video.addEventListener(
        "error",
        () => {
          hero.dataset.videoPlaying = "false";
        },
        { signal: controller.signal },
      );
      document.addEventListener("visibilitychange", syncVideo, { signal: controller.signal });
      reducedMotion.addEventListener("change", syncVideo, { signal: controller.signal });
    }

    window.addEventListener("scroll", requestUpdate, {
      passive: true,
      signal: controller.signal,
    });
    window.addEventListener("resize", handleResize, { signal: controller.signal });
    reducedMotion.addEventListener("change", requestUpdate, { signal: controller.signal });
    window.addEventListener(
      "pagehide",
      () => {
        controller.abort();
        if (frameId) window.cancelAnimationFrame(frameId);
      },
      { once: true },
    );

    update();
  });
</script>
