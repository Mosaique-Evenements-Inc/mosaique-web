---
import { Picture } from "astro:assets";

import {
  eventImageFallbackFormat,
  eventImageFormats,
  eventImageWidths,
} from "@/assets/images/events/delivery";
import ServiceFeaturedMedia from "./ServiceFeaturedMedia.astro";
import ServiceLightbox from "./ServiceLightbox.astro";
import Container from "@/core/common/ui/components/Container.astro";
import type { FeaturedMedia, GalleryImage } from "@/core/common/types/media";

interface Props {
  featuredMedia: FeaturedMedia;
  images: readonly GalleryImage[];
  slug: string;
  title: string;
}

const { featuredMedia, images, slug, title } = Astro.props;
const galleryId = `service-gallery-${slug}`;
const lightboxId = `${galleryId}-lightbox`;
---

<section class="service-gallery" aria-label={`Galería de ${title}`} id={galleryId}>
  <Container class="service-gallery__container">
    <ServiceFeaturedMedia media={featuredMedia} slug={slug} />

    <ol class="service-gallery__list">
      {
        images.map((image, index) => (
          <li class="service-gallery__item" data-layout={image.layout}>
            <button
              class="service-gallery__trigger"
              type="button"
              aria-haspopup="dialog"
              aria-controls={lightboxId}
              aria-label={`Abrir imagen ${index + 1} de ${images.length}: ${image.alt}`}
              data-service-lightbox-trigger={index}
            >
              <span class="service-gallery__reveal">
                <span class="service-gallery__media">
                  {image.status === "approved" ? (
                    <Picture
                      src={image.src}
                      alt={image.alt}
                      formats={eventImageFormats}
                      fallbackFormat={eventImageFallbackFormat}
                      widths={eventImageWidths}
                      sizes={
                        image.layout === "full-landscape"
                          ? "(min-width: 1024px) 58vw, 100vw"
                          : "(min-width: 1024px) 29vw, (min-width: 768px) 42vw, 100vw"
                      }
                      loading="lazy"
                      decoding="async"
                    />
                  ) : (
                    <span
                      class="service-gallery__placeholder"
                      data-tone={String((index % 6) + 1).padStart(2, "0")}
                      role="img"
                      aria-label={image.alt}
                    >
                      <span />
                      <span />
                    </span>
                  )}
                </span>
              </span>
            </button>
          </li>
        ))
      }
    </ol>
  </Container>

  <ServiceLightbox id={lightboxId} images={images} title={title} />
</section>
