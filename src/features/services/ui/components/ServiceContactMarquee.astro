---
import ContactMarquee from "@/core/common/ui/components/ContactMarquee.astro";
import { getHomeTranslations } from "@/features/home/i18n";
import type { Service } from "@/features/services";
import { getLocalizedHref, getLocaleFromUrl } from "@/core/i18n";

interface Props {
  service: Service;
}

const { service } = Astro.props;
const locale = getLocaleFromUrl(Astro.url);
const ctaText = getHomeTranslations(locale);
---

<ContactMarquee
  class="service-contact-marquee"
  href={getLocalizedHref(service.cta.href, locale)}
  label={ctaText.finalCtaAction}
  lead={ctaText.finalCtaText}
  navigationContrast="light"
  titleId="service-contact-marquee-title"
/>
