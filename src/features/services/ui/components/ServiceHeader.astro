---
import Button from "@/core/common/ui/components/Button";
import Heading from "@/core/common/ui/components/Heading.astro";
import Text from "@/core/common/ui/components/Text.astro";
import type { Service } from "@/features/services";
import { getLocalizedHref, getLocaleFromUrl } from "@/core/i18n";

interface Props {
  service: Service;
}

const { service } = Astro.props;
const locale = getLocaleFromUrl(Astro.url);
---

<header class="service-header" data-content-status="placeholder">
  <div class="service-header__layout">
    <Heading as="h1" variant="display-lg">{service.title}</Heading>

    <div class="service-header__narrative">
      <Text variant="body-lg" tone="inverse">{service.description}</Text>
      <Button
        className="service-header__cta"
        href={getLocalizedHref(service.cta.href, locale)}
        variant="light"
      >
        {service.cta.label}
      </Button>
    </div>

    <div class="service-header__divider" aria-hidden="true"></div>
  </div>
</header>
