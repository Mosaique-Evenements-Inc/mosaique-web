---
import PanelReveal from "@/core/common/ui/motion/PanelReveal.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Footer from "@/features/site-shell/ui/components/Footer.astro";
import Navigation from "@/features/site-shell/ui/components/Navigation.astro";
import { getLocalizedAboutMedia } from "../../content/about";
import AboutHero from "../components/AboutHero.astro";
import AboutMediaMosaic from "../components/AboutMediaMosaic.astro";
import { getAboutTranslations } from "@/features/about/i18n";
import { getLocaleFromUrl } from "@/core/i18n";

import "../styles/about-page.css";

const locale = getLocaleFromUrl(Astro.url);
const aboutText = getAboutTranslations(locale);
---

<BaseLayout
  title={aboutText.metadataTitle}
  description={aboutText.metadataDescription}
  surface="cinematic"
>
  <Navigation anchorPrefix="/" />
  <main id="main-content">
    <PanelReveal class="about-page__reveal">
      <AboutHero slot="lead" lines={aboutText.heroLines} caption={aboutText.heroCaption} />
      <AboutMediaMosaic label={aboutText.mosaicLabel} items={getLocalizedAboutMedia(locale)} />
    </PanelReveal>
  </main>
  <Footer />
</BaseLayout>
