---
import AboutMediaItem from "./AboutMediaItem.astro";
import type { AboutMediaItem as MediaItem } from "@/features/about/content/about";

interface Props {
  label: string;
  items: readonly MediaItem[];
}

const { label, items } = Astro.props;
---

<section
  id="about-mosaic"
  class="about-mosaic"
  data-navigation-contrast="light"
  aria-label={label}
>
  <ul class="about-mosaic__list" aria-hidden="true">
    {
      items.map((item) => (
        <li
          class="about-mosaic__item"
          data-desktop-column-start={item.desktopColumnStart || undefined}
        >
          <AboutMediaItem item={item} />
        </li>
      ))
    }
  </ul>
</section>
