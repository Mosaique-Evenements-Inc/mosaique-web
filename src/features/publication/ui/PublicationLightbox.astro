---
import Icon from "@/core/common/ui/components/Icon.astro";
import { galleryTranslations } from "@/features/gallery/i18n";
import { getLocaleFromUrl } from "@/core/i18n";
import type { CmsMedia } from "../publication.mjs";
import PublicationImage from "./PublicationImage.astro";

interface Props {
  id: string;
  kind: "service" | "event";
  images: CmsMedia[];
  title: string;
}

const { id, kind, images, title } = Astro.props;
const galleryText = galleryTranslations[getLocaleFromUrl(Astro.url)];
const className = `${kind}-lightbox`;
---

<dialog
  class={className}
  id={id}
  data-publication-lightbox
  data-image-label={galleryText.image}
  data-of-label={galleryText.of}
  aria-labelledby={`${id}-title`}
>
  <div class={`${className}__surface`}>
    <header class={`${className}__header`}>
      <h2 class="visually-hidden" id={`${id}-title`}>{galleryText.expandedGallery} {title}</h2>
      <p data-publication-lightbox-status aria-live="polite" aria-atomic="true"></p>
      <button
        type="button"
        data-publication-lightbox-close
        aria-label={galleryText.closeGallery}
      >
        <Icon name="xmark" size={24} />
      </button>
    </header>

    <div class={`${className}__stage`} data-publication-lightbox-stage>
      {
        images.map((image, index) => (
          <figure
            class={`${className}__panel`}
            data-publication-lightbox-panel={index}
            data-active={index === 0 ? "true" : "false"}
            hidden={index !== 0}
          >
            <PublicationImage media={image} sizes="100vw" loading="lazy" />
            {image.alt && <figcaption class="visually-hidden">{image.alt}</figcaption>}
          </figure>
        ))
      }
    </div>

    <nav class={`${className}__controls`} aria-label={galleryText.galleryNavigation}>
      <button
        type="button"
        data-publication-lightbox-previous
        aria-label={galleryText.previousImage}
      >
        <Icon name="arrowLeft" size={22} />
        <span>{galleryText.previous}</span>
      </button>
      <button type="button" data-publication-lightbox-next aria-label={galleryText.nextImage}>
        <span>{galleryText.next}</span>
        <Icon name="arrowRight" size={22} />
      </button>
    </nav>
  </div>
</dialog>

<script>
  document
    .querySelectorAll<HTMLDialogElement>("[data-publication-lightbox]")
    .forEach((dialog) => {
      if (dialog.dataset.ready === "true") return;
      dialog.dataset.ready = "true";

      const gallery = dialog.closest<HTMLElement>("section");
      const triggers = Array.from(
        gallery?.querySelectorAll<HTMLButtonElement>("[data-publication-lightbox-trigger]") ??
          [],
      );
      const panels = Array.from(
        dialog.querySelectorAll<HTMLElement>("[data-publication-lightbox-panel]"),
      );
      const closeButton = dialog.querySelector<HTMLButtonElement>(
        "[data-publication-lightbox-close]",
      );
      const previousButton = dialog.querySelector<HTMLButtonElement>(
        "[data-publication-lightbox-previous]",
      );
      const nextButton = dialog.querySelector<HTMLButtonElement>(
        "[data-publication-lightbox-next]",
      );
      const status = dialog.querySelector<HTMLElement>("[data-publication-lightbox-status]");
      const stage = dialog.querySelector<HTMLElement>("[data-publication-lightbox-stage]");
      const controller = new AbortController();
      let activeIndex = 0;
      let opener: HTMLButtonElement | null = null;
      let previousOverflow = "";

      const render = () => {
        panels.forEach((panel, index) => {
          const active = index === activeIndex;
          panel.hidden = !active;
          panel.dataset.active = String(active);
        });
        if (previousButton) previousButton.disabled = activeIndex === 0;
        if (nextButton) nextButton.disabled = activeIndex === panels.length - 1;
        if (status) {
          status.textContent = `${dialog.dataset.imageLabel} ${activeIndex + 1} ${dialog.dataset.ofLabel} ${panels.length}`;
        }
      };

      const open = (index: number, trigger: HTMLButtonElement) => {
        activeIndex = index;
        opener = trigger;
        previousOverflow = document.documentElement.style.overflow;
        render();
        dialog.showModal();
        document.documentElement.style.overflow = "hidden";
        closeButton?.focus();
      };
      const close = () => dialog.close();
      const goTo = (index: number) => {
        activeIndex = Math.min(Math.max(index, 0), panels.length - 1);
        render();
      };

      triggers.forEach((trigger, index) => {
        trigger.addEventListener("click", () => open(index, trigger), {
          signal: controller.signal,
        });
      });
      closeButton?.addEventListener("click", close, { signal: controller.signal });
      previousButton?.addEventListener("click", () => goTo(activeIndex - 1), {
        signal: controller.signal,
      });
      nextButton?.addEventListener("click", () => goTo(activeIndex + 1), {
        signal: controller.signal,
      });
      dialog.addEventListener(
        "click",
        (event) => {
          const target = event.target;
          if (
            target === dialog ||
            target === stage ||
            (target instanceof HTMLElement &&
              target.matches("[data-publication-lightbox-panel]"))
          )
            close();
        },
        { signal: controller.signal },
      );
      dialog.addEventListener(
        "keydown",
        (event) => {
          if (event.key === "Escape") {
            event.preventDefault();
            close();
            return;
          }
          if (event.key === "ArrowLeft") goTo(activeIndex - 1);
          if (event.key === "ArrowRight") goTo(activeIndex + 1);
        },
        { signal: controller.signal },
      );
      dialog.addEventListener(
        "close",
        () => {
          document.documentElement.style.overflow = previousOverflow;
          opener?.focus();
          opener = null;
        },
        { signal: controller.signal },
      );
      window.addEventListener("pagehide", () => controller.abort(), {
        once: true,
        signal: controller.signal,
      });
    });
</script>
