---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Footer from "@/features/site-shell/ui/components/Footer.astro";
import Navigation from "@/features/site-shell/ui/components/Navigation.astro";
import type { EventGalleryItem } from "@/features/gallery";
import GalleryArchive from "../components/GalleryArchive.astro";
import { galleryTranslations } from "@/features/gallery/i18n";
import { getLocaleFromUrl } from "@/core/i18n";

interface Props {
  activeCategoryId?: string;
  items: readonly EventGalleryItem[];
  title: string;
}

const { activeCategoryId, items, title } = Astro.props;
const galleryText = galleryTranslations[getLocaleFromUrl(Astro.url)];
---

<BaseLayout title={title} description={galleryText.archiveDescription}>
  <Navigation anchorPrefix="/" />
  <main class="gallery-page" id="main-content" tabindex="-1">
    <GalleryArchive {activeCategoryId} {items} />
  </main>
  <Footer anchorPrefix="/" />
</BaseLayout>
