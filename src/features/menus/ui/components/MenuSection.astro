---
import { type Locale } from "@/core/i18n";
import Heading from "@/core/common/ui/components/Heading.astro";
import type { MenuRelatedEvent, MenuSection as MenuSectionData } from "../../types";
import MenuItem from "./MenuItem.astro";
import MenuSectionIcon from "./MenuSectionIcon.astro";

interface Props {
  section: MenuSectionData;
  locale: Locale;
  relatedEvent?: MenuRelatedEvent;
}

const { section, locale, relatedEvent } = Astro.props;
const headingId = `menu-section-${section.id}`;
const dessert = section.id === "desserts";
---

<section
  class:list={["menu-page__section", { "menu-page__section--desserts": dessert }]}
  aria-labelledby={headingId}
>
  <div class="menu-page__section-heading">
    <MenuSectionIcon class="menu-page__section-icon" {dessert} />
    <Heading as="h2" variant="heading-md" class="menu-page__section-title" id={headingId}>
      {section.title}
    </Heading>
  </div>
  <ul class="menu-page__items">
    {section.items.map((item) => <MenuItem {item} {locale} {dessert} {relatedEvent} />)}
  </ul>
</section>
