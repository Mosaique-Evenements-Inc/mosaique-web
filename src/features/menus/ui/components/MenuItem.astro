---
import { type Locale } from "@/core/i18n";
import Text from "@/core/common/ui/components/Text.astro";
import { formatMenuPrice, type MenuItem as MenuItemData } from "@/features/menus";

interface Props {
  item: MenuItemData;
  locale: Locale;
}

const { item, locale } = Astro.props;
---

<li class="menu-page__item">
  <div class="menu-page__item-copy">
    <h3 class="menu-page__item-name">{item.name}</h3>
    {item.description && <Text class="menu-page__item-description">{item.description}</Text>}
  </div>
  <span class="menu-page__price">{formatMenuPrice(item.price, locale)}</span>
</li>
