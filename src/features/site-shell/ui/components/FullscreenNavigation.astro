---
import Icon from "@/core/common/ui/components/Icon.astro";
import topbarLogo from "@/assets/logos/logo_topbar.png";
import { footerContent } from "@/features/site-shell/content/footer";
import {
  navigationContent,
  serviceNavigationItems,
} from "@/features/site-shell/content/navigation";
import { siteShellTranslations } from "@/features/site-shell/i18n";
import { getLocalizedHref, getLocaleFromUrl } from "@/core/i18n";
import LanguageSwitcher from "./LanguageSwitcher.astro";

interface Props {
  anchorPrefix?: string;
}

const { anchorPrefix = "" } = Astro.props;
const locale = getLocaleFromUrl(Astro.url);
const shellText = siteShellTranslations[locale];
const resolveHref = (href: string) =>
  href.startsWith("#")
    ? anchorPrefix
      ? `${getLocalizedHref(anchorPrefix, locale)}${href}`
      : href
    : getLocalizedHref(href, locale);
const isCurrentPage = (href: string) =>
  href.startsWith("/") &&
  (Astro.url.pathname === getLocalizedHref(href, locale) ||
    Astro.url.pathname.startsWith(`${getLocalizedHref(href, locale)}/`));
---

<div class="site-navigation__mobile-navigation">
  <button
    class="site-navigation__menu-trigger"
    type="button"
    aria-label={shellText["navigation.open"]}
    aria-expanded="false"
    aria-controls="site-navigation-dialog"
  >
    <Icon name="menu" size={24} />
  </button>

  <dialog
    class="site-navigation__dialog"
    id="site-navigation-dialog"
    aria-labelledby="site-navigation-dialog-title"
    tabindex="-1"
  >
    <div class="site-navigation__dialog-layout">
      <div class="site-navigation__dialog-header">
        <a
          class="site-navigation__dialog-brand"
          href={resolveHref("#top")}
          id="site-navigation-dialog-title"
          aria-label={`${navigationContent.logo} — ${shellText.navigationLabels[0]}`}
        >
          <span
            class="site-navigation__dialog-logo-mark"
            style={`--topbar-logo-url:url("${topbarLogo.src}");`}
            aria-hidden="true"></span>
        </a>

        <button
          class="site-navigation__dialog-close"
          type="button"
          aria-label={shellText["navigation.close"]}
        >
          <Icon name="xmark" size={28} />
        </button>
      </div>

      <nav class="site-navigation__dialog-nav" aria-label={shellText["navigation.main"]}>
        <ol>
          {
            navigationContent.desktopItems.map((item, index) =>
              item.href === "#services" ? (
                <li
                  class="site-navigation__services-accordion"
                  style={`--navigation-item-index:${index};`}
                  data-services-accordion
                >
                  <button
                    class="site-navigation__services-accordion-trigger"
                    type="button"
                    aria-expanded="false"
                    aria-controls="site-navigation-services-accordion"
                  >
                    <span>
                      {shellText.navigationLabels[navigationContent.items.indexOf(item)] ??
                        item.label}
                    </span>
                    <span
                      class="site-navigation__services-accordion-indicator"
                      aria-hidden="true"
                    />
                  </button>

                  <div
                    class="site-navigation__services-accordion-content"
                    id="site-navigation-services-accordion"
                    aria-hidden="true"
                    data-services-accordion-content
                    inert
                  >
                    <ul>
                      {serviceNavigationItems.map((service, serviceIndex) => (
                        <li>
                          <a
                            href={getLocalizedHref(service.href, locale)}
                            aria-current={isCurrentPage(service.href) ? "page" : undefined}
                          >
                            {shellText.serviceLabels[serviceIndex] ?? service.label}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                </li>
              ) : (
                <li style={`--navigation-item-index:${index};`}>
                  <a
                    href={resolveHref(item.href)}
                    aria-current={isCurrentPage(item.href) ? "page" : undefined}
                  >
                    <span>
                      {shellText.navigationLabels[navigationContent.items.indexOf(item)] ??
                        item.label}
                    </span>
                  </a>
                </li>
              ),
            )
          }
        </ol>
      </nav>

      <div class="site-navigation__dialog-footer">
        <LanguageSwitcher placement="mobile" />
        <div class="site-navigation__dialog-meta">
          <span>{footerContent.contact.location}</span>
          <a href={footerContent.contact.email.href}>{footerContent.contact.email.label}</a>
        </div>
      </div>
    </div>
  </dialog>
</div>

<script>
  document
    .querySelectorAll<HTMLElement>(".site-navigation__mobile-navigation")
    .forEach((navigation) => {
      if (navigation.dataset.menuReady === "true") return;
      navigation.dataset.menuReady = "true";

      const trigger = navigation.querySelector<HTMLButtonElement>(
        ".site-navigation__menu-trigger",
      );
      const dialog = navigation.querySelector<HTMLDialogElement>(".site-navigation__dialog");
      const closeButton = dialog?.querySelector<HTMLButtonElement>(
        ".site-navigation__dialog-close",
      );
      const servicesAccordion = dialog?.querySelector<HTMLElement>("[data-services-accordion]");
      const servicesTrigger = servicesAccordion?.querySelector<HTMLButtonElement>(
        ".site-navigation__services-accordion-trigger",
      );
      const servicesContent = servicesAccordion?.querySelector<HTMLElement>(
        "[data-services-accordion-content]",
      );
      const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
      const desktop = window.matchMedia("(min-width: 80rem)");
      const root = document.documentElement;
      const body = document.body;
      let previousRootOverflow = "";
      let previousBodyOverflow = "";
      let restoreTriggerFocus = false;
      let closeTimer = 0;

      if (!trigger || !dialog || !closeButton) return;

      const setServicesExpanded = (expanded: boolean) => {
        if (!servicesAccordion || !servicesTrigger || !servicesContent) return;
        servicesAccordion.toggleAttribute("data-open", expanded);
        servicesTrigger.setAttribute("aria-expanded", String(expanded));
        servicesContent.setAttribute("aria-hidden", String(!expanded));
        servicesContent.inert = !expanded;
      };

      const unlockScroll = () => {
        root.style.overflow = previousRootOverflow;
        body.style.overflow = previousBodyOverflow;
      };

      const finishClose = () => {
        window.clearTimeout(closeTimer);
        dialog.removeAttribute("data-closing");
        if (dialog.open) dialog.close();
      };

      const closeMenu = ({ returnFocus = true, immediate = false } = {}) => {
        if (!dialog.open) return;
        restoreTriggerFocus = returnFocus;

        if (immediate || reducedMotion.matches) {
          finishClose();
          return;
        }

        dialog.setAttribute("data-closing", "true");
        closeTimer = window.setTimeout(finishClose, 360);
      };

      trigger.addEventListener("click", () => {
        previousRootOverflow = root.style.overflow;
        previousBodyOverflow = body.style.overflow;
        root.style.overflow = "hidden";
        body.style.overflow = "hidden";
        trigger.setAttribute("aria-expanded", "true");
        dialog.showModal();
        dialog.focus({ preventScroll: true });
      });

      closeButton.addEventListener("click", () => closeMenu());
      servicesTrigger?.addEventListener("click", () => {
        setServicesExpanded(!servicesAccordion?.hasAttribute("data-open"));
      });

      dialog.addEventListener("cancel", (event) => {
        event.preventDefault();
        closeMenu();
      });

      dialog.addEventListener("click", (event) => {
        const link = (event.target as Element).closest<HTMLAnchorElement>("a[href]");
        if (link) closeMenu({ returnFocus: false, immediate: true });
      });

      dialog.addEventListener("animationend", (event) => {
        if (event.target === dialog && dialog.hasAttribute("data-closing")) finishClose();
      });

      dialog.addEventListener("close", () => {
        unlockScroll();
        trigger.setAttribute("aria-expanded", "false");
        setServicesExpanded(false);
        if (restoreTriggerFocus) trigger.focus();
        restoreTriggerFocus = false;
      });

      desktop.addEventListener("change", (event) => {
        if (event.matches) closeMenu({ returnFocus: false, immediate: true });
      });
    });
</script>
