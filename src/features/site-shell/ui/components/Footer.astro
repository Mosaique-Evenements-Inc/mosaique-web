---
import Container from "@/core/common/ui/components/Container.astro";
import Icon from "@/core/common/ui/components/Icon.astro";
import { collaborators } from "@/features/site-shell/content/collaborators";
import { footerContent } from "@/features/site-shell/content/footer";

import "@/features/site-shell/ui/styles/footer.css";

const primaryLinks = footerContent.links.slice(0, 4);
const secondaryLinks = footerContent.links.slice(4);
interface Props {
  anchorPrefix?: string;
}

const { anchorPrefix = "" } = Astro.props;
const resolveHref = (href: string) =>
  anchorPrefix && href.startsWith("#") ? `${anchorPrefix}${href}` : href;
---

<footer
  class="site-footer"
  id="footer"
  aria-labelledby="footer-brand"
  data-navigation-contrast="light"
>
  <Container bleed class="site-footer__container">
    <h2 class="site-footer__sr-only" id="footer-brand">{footerContent.logo}</h2>

    <div class="site-footer__top">
      <nav class="site-footer__navigation" aria-label="Navegación del pie de página">
        <details open data-footer-group>
          <summary>
            <h3>Compañía</h3>
            <span aria-hidden="true"><Icon name="plus" size={20} /></span>
          </summary>
          <ul>
            {
              primaryLinks.map((link) => (
                <li>
                  <a href={resolveHref(link.href)}>{link.label}</a>
                </li>
              ))
            }
          </ul>
        </details>

        <details open data-footer-group>
          <summary>
            <h3>Recursos</h3>
            <span aria-hidden="true"><Icon name="plus" size={20} /></span>
          </summary>
          <ul>
            {
              secondaryLinks.map((link) => (
                <li>
                  <a href={resolveHref(link.href)}>{link.label}</a>
                </li>
              ))
            }
          </ul>
        </details>

        <details open data-footer-group>
          <summary>
            <h3>Servicios</h3>
            <span aria-hidden="true"><Icon name="plus" size={20} /></span>
          </summary>
          <ul>
            {footerContent.services.map((service) => <li>{service}</li>)}
          </ul>
        </details>
      </nav>

      <div class="site-footer__logo-wall" role="list" aria-label="Colaboradores">
        {
          collaborators.map((collaborator) => (
            <div class="site-footer__logo-tile" role="listitem">
              <a
                class="site-footer__collaborator-link"
                href={collaborator.link}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`Visitar el sitio de ${collaborator.nombre} (se abre en una pestaña nueva)`}
              >
                <img
                  class:list={[
                    "site-footer__collaborator-logo",
                    `site-footer__collaborator-logo--${collaborator.proportion}`,
                  ]}
                  src={collaborator.path}
                  alt={`Logo de ${collaborator.nombre}`}
                  width={collaborator.image.width}
                  height={collaborator.image.height}
                  loading="lazy"
                  decoding="async"
                />
              </a>
            </div>
          ))
        }
      </div>
    </div>

    <div class="site-footer__middle">
      <div class="site-footer__contact-lead">
        <h3>{footerContent.contact.purpose}</h3>
        <a class="site-footer__contact-action" href={footerContent.contact.email.href}>
          <span>{footerContent.contact.email.label}</span>
          <Icon name="arrowRight" size={20} />
        </a>
      </div>

      <div class="site-footer__details">
        <address class="site-footer__contact">
          <div>
            <span>Teléfono</span>
            <a href={footerContent.contact.phone.href}>{footerContent.contact.phone.label}</a>
          </div>
          <div>
            <span>Email</span>
            <a href={footerContent.contact.email.href}>{footerContent.contact.email.label}</a>
          </div>
          <div>
            <span>Ubicación</span>
            <p>{footerContent.contact.location}</p>
          </div>
        </address>
      </div>
    </div>

    <div class="site-footer__legal">
      <p>{footerContent.closingStatement}</p>
      <p>{footerContent.legal}</p>
    </div>
  </Container>
</footer>

<script>
  const footerGroups = Array.from(
    document.querySelectorAll<HTMLDetailsElement>("[data-footer-group]"),
  );
  const compactFooter = window.matchMedia("(max-width: 47.99rem)");

  const syncFooterGroups = () => {
    footerGroups.forEach((group) => {
      group.open = !compactFooter.matches;
    });
  };

  footerGroups.forEach((group) => {
    group.querySelector("summary")?.addEventListener("click", (event) => {
      if (!compactFooter.matches) event.preventDefault();
    });
  });
  compactFooter.addEventListener("change", syncFooterGroups);
  syncFooterGroups();
</script>
