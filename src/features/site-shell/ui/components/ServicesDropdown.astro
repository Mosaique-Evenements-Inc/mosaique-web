---
import { serviceNavigationItems } from "@/features/site-shell/content/navigation";
import { getLocalizedHref, getLocaleFromUrl } from "@/core/i18n";
import NavigationDropdown from "./NavigationDropdown.astro";

interface Props {
  label: string;
  labels?: readonly string[];
}

const { label, labels = [] } = Astro.props;
const locale = getLocaleFromUrl(Astro.url);
const panelId = "site-navigation-services-menu";
const isCurrentPage = (href: string) =>
  Astro.url.pathname === getLocalizedHref(href, locale) ||
  Astro.url.pathname.startsWith(`${getLocalizedHref(href, locale)}/`);
const items = serviceNavigationItems.map((item, index) => ({
  current: isCurrentPage(item.href),
  href: getLocalizedHref(item.href, locale),
  label: labels[index] ?? item.label,
}));
---

<NavigationDropdown
  className="site-navigation__services-dropdown"
  items={items}
  label={label}
  panelId={panelId}
/>
