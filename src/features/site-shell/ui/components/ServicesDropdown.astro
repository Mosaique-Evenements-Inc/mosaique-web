---
import { getPublication } from "@/features/publication/publication.mjs";
import { getLocalizedHref, getLocaleFromUrl } from "@/core/i18n";
import NavigationDropdown from "./NavigationDropdown.astro";

interface Props {
  label: string;
}

const { label } = Astro.props;
const locale = getLocaleFromUrl(Astro.url);
const panelId = "site-navigation-services-menu";
const isCurrentPage = (href: string) =>
  Astro.url.pathname === getLocalizedHref(href, locale) ||
  Astro.url.pathname.startsWith(`${getLocalizedHref(href, locale)}/`);
const items = getPublication(locale).services.map((service) => ({
  current: isCurrentPage(`/services/${service.slug}`),
  href: getLocalizedHref(`/services/${service.slug}`, locale),
  label: service.title,
}));
---

<NavigationDropdown
  className="site-navigation__services-dropdown"
  items={items}
  label={label}
  panelId={panelId}
/>
