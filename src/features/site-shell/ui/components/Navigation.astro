---
import Container from "@/core/common/ui/components/Container.astro";
import FullscreenNavigation from "./FullscreenNavigation.astro";
import ServicesDropdown from "./ServicesDropdown.astro";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import topbarLogo from "@/assets/logos/logo_topbar.png";
import { navigationContent } from "@/features/site-shell/content/navigation";
import { getSiteShellTranslations } from "@/features/site-shell/i18n";
import { getLocalizedHref, getLocaleFromUrl } from "@/core/i18n";

import "@/features/site-shell/ui/styles/home-entry.css";
import "@/features/site-shell/ui/styles/navigation-menu.css";

const locale = getLocaleFromUrl(Astro.url);
const shellText = getSiteShellTranslations(locale);
interface Props {
  anchorPrefix?: string;
  surface?: "overlay" | "solid";
}

const { anchorPrefix = "", surface = "overlay" } = Astro.props;
const isHomePage = Astro.url.pathname === getLocalizedHref("/", locale);
const resolveHref = (href: string) =>
  href.startsWith("#")
    ? anchorPrefix
      ? `${getLocalizedHref(anchorPrefix, locale)}${href}`
      : href
    : getLocalizedHref(href, locale);
const isCurrentPage = (href: string) =>
  href.startsWith("/") &&
  (() => {
    const localizedHref = getLocalizedHref(href, locale);
    return (
      Astro.url.pathname === localizedHref || Astro.url.pathname.startsWith(`${localizedHref}/`)
    );
  })();
---

<header
  class:list={[
    "site-navigation",
    {
      "site-navigation--home": isHomePage,
      "site-navigation--solid": surface === "solid",
    },
  ]}
  data-navigation-surface={surface}
>
  <Container class="site-navigation__inner">
    <a
      class="site-navigation__logo"
      href={resolveHref("#top")}
      data-home-reset={isHomePage ? "true" : undefined}
      aria-label={`${navigationContent.logo} — ${shellText.navigationLabels[0]}`}
    >
      <span
        class="site-navigation__logo-mark"
        style={`--topbar-logo-url:url("${topbarLogo.src}");`}
        aria-hidden="true"></span>
    </a>

    <nav class="site-navigation__desktop-nav" aria-label={shellText["navigation.main"]}>
      <ul>
        {
          navigationContent.desktopItems.map((item) =>
            item.href === "#services" ? (
              <ServicesDropdown
                label={
                  shellText.navigationLabels[navigationContent.items.indexOf(item)] ??
                  item.label
                }
                labels={shellText.serviceLabels}
              />
            ) : (
              <li>
                <a
                  href={resolveHref(item.href)}
                  aria-current={isCurrentPage(item.href) ? "page" : undefined}
                >
                  {shellText.navigationLabels[navigationContent.items.indexOf(item)] ??
                    item.label}
                </a>
              </li>
            ),
          )
        }
      </ul>
    </nav>

    <LanguageSwitcher placement="desktop" />
    <FullscreenNavigation anchorPrefix={anchorPrefix} />
  </Container>
</header>

<script>
  document
    .querySelectorAll<HTMLAnchorElement>('.site-navigation__logo[data-home-reset="true"]')
    .forEach((logo) => {
      if (logo.dataset.homeResetReady === "true") return;
      logo.dataset.homeResetReady = "true";

      logo.addEventListener("click", (event) => {
        event.preventDefault();

        const cleanUrl = `${window.location.pathname}${window.location.search}`;
        window.history.replaceState(window.history.state, "", cleanUrl);

        const root = document.documentElement;
        const previousScrollBehavior = root.style.getPropertyValue("scroll-behavior");
        const previousScrollPriority = root.style.getPropertyPriority("scroll-behavior");
        root.style.setProperty("scroll-behavior", "auto", "important");

        const scrollingElement = document.scrollingElement;
        const resetScrollPosition = () => {
          if (scrollingElement) scrollingElement.scrollTop = 0;
          root.scrollTop = 0;
          document.body.scrollTop = 0;
          window.dispatchEvent(new Event("scroll"));
        };

        resetScrollPosition();

        window.requestAnimationFrame(() => {
          resetScrollPosition();
          window.requestAnimationFrame(() => {
            if (previousScrollBehavior) {
              root.style.setProperty(
                "scroll-behavior",
                previousScrollBehavior,
                previousScrollPriority,
              );
              return;
            }

            root.style.removeProperty("scroll-behavior");
          });
        });
      });
    });

  document.querySelectorAll<HTMLElement>(".site-navigation").forEach((navigation) => {
    if (
      navigation.dataset.navigationReady === "true" ||
      navigation.dataset.navigationSurface === "solid"
    ) {
      return;
    }

    navigation.dataset.navigationReady = "true";

    const controller = new AbortController();
    let frameId = 0;

    const updateContrast = () => {
      frameId = 0;

      const sampleY = Math.min(
        Math.max(navigation.offsetHeight / 2, 0),
        window.innerHeight - 1,
      );
      const layers = document.elementsFromPoint(window.innerWidth / 2, sampleY);
      const surface = layers
        .filter((element) => element !== navigation && !navigation.contains(element))
        .map((element) => element.closest<HTMLElement>("[data-navigation-contrast]"))
        .find((element): element is HTMLElement => Boolean(element));
      const contrast = surface?.dataset.navigationContrast ?? "dark";

      navigation.dataset.navigationActiveContrast = contrast;
      navigation.style.setProperty(
        "--navigation-color-progress",
        contrast === "light" ? "0%" : "100%",
      );
    };

    const requestUpdate = () => {
      if (!frameId) frameId = window.requestAnimationFrame(updateContrast);
    };

    const resetContrast = () => {
      navigation.removeAttribute("data-navigation-active-contrast");
      navigation.style.removeProperty("--navigation-color-progress");
    };

    window.addEventListener("scroll", requestUpdate, {
      passive: true,
      signal: controller.signal,
    });
    window.addEventListener("resize", requestUpdate, { signal: controller.signal });
    document.addEventListener("astro:before-swap", resetContrast, {
      signal: controller.signal,
    });
    document.addEventListener("astro:after-swap", requestUpdate, { signal: controller.signal });
    document.addEventListener("astro:page-load", requestUpdate, { signal: controller.signal });
    window.addEventListener(
      "pagehide",
      () => {
        controller.abort();
        if (frameId) window.cancelAnimationFrame(frameId);
      },
      { once: true },
    );

    updateContrast();
  });
</script>
