---
import {
  getLanguageTag,
  getLocaleFromUrl,
  supportedLocales,
  switchLocaleUrl,
} from "@/core/i18n";
import { getSiteShellTranslations } from "@/features/site-shell/i18n";
import NavigationDropdown from "./NavigationDropdown.astro";

interface Props {
  placement: "desktop" | "mobile";
}

const { placement } = Astro.props;
const locale = getLocaleFromUrl(Astro.url);
const shellText = getSiteShellTranslations(locale);
const languageItems = supportedLocales.map((targetLocale) => ({
  ariaLabel:
    targetLocale === locale
      ? `${targetLocale.toUpperCase()}, ${shellText["navigation.currentLanguage"]}`
      : targetLocale.toUpperCase(),
  current: targetLocale === locale,
  href: switchLocaleUrl(Astro.url, targetLocale),
  hreflang: getLanguageTag(targetLocale),
  label: targetLocale.toUpperCase(),
  lang: getLanguageTag(targetLocale),
}));
---

<nav
  class:list={["site-navigation__language-switcher", `is-${placement}`]}
  aria-label={shellText["navigation.language"]}
  data-language-switcher
>
  {
    placement === "desktop" ? (
      <ul>
        <NavigationDropdown
          className="site-navigation__language-dropdown"
          items={languageItems}
          label={locale.toUpperCase()}
          panelId="site-navigation-language-menu"
        />
      </ul>
    ) : (
      <ul>
        {languageItems.map((item) => (
          <li>
            <a
              href={item.href}
              hreflang={item.hreflang}
              lang={item.lang}
              aria-current={item.current ? "page" : undefined}
              aria-label={item.ariaLabel}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    )
  }
</nav>

<script>
  const syncLanguageHashes = () => {
    document.querySelectorAll<HTMLElement>("[data-language-switcher]").forEach((switcher) => {
      switcher.querySelectorAll<HTMLAnchorElement>("a[href]").forEach((link) => {
        const target = new URL(link.href, window.location.href);
        target.search = window.location.search;
        target.hash = window.location.hash;
        link.href = `${target.pathname}${target.search}${target.hash}`;
      });
    });
  };

  window.addEventListener("hashchange", syncLanguageHashes);
  document.addEventListener("astro:page-load", syncLanguageHashes);
  syncLanguageHashes();
</script>
