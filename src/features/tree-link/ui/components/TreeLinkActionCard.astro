---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

import Icon, { type IconName } from "@/core/common/ui/components/Icon.astro";
import type { TreeLinkSocialId } from "@/features/tree-link/content/tree-link";
import TreeLinkSocialIcon from "./TreeLinkSocialIcon.astro";

interface Props {
  description: string;
  href?: string | null;
  highlight?: boolean;
  icon?: IconName;
  imageIcon?: ImageMetadata;
  socialIcon?: TreeLinkSocialId;
  label: string;
  pendingLabel?: string;
}

const {
  description,
  highlight = false,
  href,
  icon,
  imageIcon,
  label,
  socialIcon,
} = Astro.props;
---

{
  href ? (
    <a
      class:list={[
        "tree-link-card",
        "tree-link-card--link",
        { "tree-link-card--highlight": highlight },
      ]}
      href={href}
    >
      <span
        class:list={[
          "tree-link-card__icon",
          {
            "tree-link-card__icon--brand": imageIcon,
            "tree-link-card__icon--social": socialIcon,
          },
        ]}
        aria-hidden="true"
      >
        {imageIcon ? (
          <span class="tree-link-card__brand-icon-crop">
            <Image
              src={imageIcon}
              alt=""
              class="tree-link-card__brand-icon"
              width={128}
              height={128}
              loading="eager"
              decoding="async"
            />
          </span>
        ) : socialIcon ? (
          <TreeLinkSocialIcon name={socialIcon} />
        ) : (
          icon && <Icon name={icon} size={24} />
        )}
      </span>
      <span class="tree-link-card__copy">
        <strong>{label}</strong>
        <span>{description}</span>
      </span>
      <span class="tree-link-card__action" aria-hidden="true">
        <Icon name="arrowRight" size={20} />
      </span>
    </a>
  ) : (
    <article class="tree-link-card tree-link-card--pending">
      <span
        class:list={[
          "tree-link-card__icon",
          {
            "tree-link-card__icon--brand": imageIcon,
            "tree-link-card__icon--social": socialIcon,
          },
        ]}
        aria-hidden="true"
      >
        {imageIcon ? (
          <span class="tree-link-card__brand-icon-crop">
            <Image
              src={imageIcon}
              alt=""
              class="tree-link-card__brand-icon"
              width={128}
              height={128}
              loading="eager"
              decoding="async"
            />
          </span>
        ) : socialIcon ? (
          <TreeLinkSocialIcon name={socialIcon} />
        ) : (
          icon && <Icon name={icon} size={24} />
        )}
      </span>
      <span class="tree-link-card__copy">
        <strong>{label}</strong>
        <span>{description}</span>
      </span>
    </article>
  )
}
