---
import LeadSubmissionTransport from "./LeadSubmissionTransport";
import QuoteBasicStep from "./QuoteBasicStep.astro";
import QuoteReview from "./QuoteReview.astro";
import Button from "@/core/common/ui/components/Button";
import Icon from "@/core/common/ui/components/Icon.astro";
import { getQuoteTranslations } from "../../i18n";
import { getLanguageTag, getLocalizedHref, getLocaleFromUrl } from "@/core/i18n";

const locale = getLocaleFromUrl(Astro.url);
const quoteText = getQuoteTranslations(locale);

import "../styles/quote-form.css";
---

<div
  class="quote-flow"
  data-quote-flow
  data-quote-text={JSON.stringify(quoteText)}
  data-language-tag={getLanguageTag(locale)}
  data-back-href={getLocalizedHref("/", locale)}
>
  <form class="quote-form" data-quote-form novalidate>
    <div class="quote-form__navigation">
      <button
        type="button"
        class="quote-form__back"
        aria-label={quoteText.backToPreviousPage}
        data-quote-back
      >
        <Icon name="arrowLeft" size={24} />
        <span class="visually-hidden" data-quote-back-label>{quoteText.back}</span>
      </button>
    </div>

    <div class="quote-form__body">
      <QuoteBasicStep />
      <QuoteReview />
    </div>

    <footer class="quote-form__actions" data-quote-actions>
      <p data-quote-submit-status aria-live="polite"></p>
      <div>
        <Button type="button" className="quote-button" data-quote-next variant="light">
          <span data-quote-next-label>{quoteText.submit}</span>
        </Button>
      </div>
    </footer>
  </form>
</div>

<aside
  class="quote-toast"
  data-quote-success-toast
  data-state="closed"
  role="status"
  aria-live="polite"
  aria-atomic="true"
  hidden
>
  <span class="quote-toast__icon" aria-hidden="true"><Icon name="checkCircle" size={24} /></span
  >
  <div>
    <strong>{quoteText.submissionSuccess}</strong>
    <p>{quoteText.submissionThanks}</p>
  </div>
  <button type="button" data-quote-toast-close aria-label={quoteText.closeConfirmation}>
    <Icon name="xmark" size={20} />
  </button>
</aside>

<LeadSubmissionTransport client:load />

<script>
  import type { LeadApiError, LeadFormInput, QuoteSubmissionDetail } from "../../types";
  import { validatePhone } from "../../validators/leads";

  const quoteFlow = document.querySelector<HTMLElement>("[data-quote-flow]");
  const datePickerDialog = document.querySelector<HTMLElement>("[data-date-picker-dialog]");
  const quoteForm = quoteFlow?.querySelector<HTMLFormElement>("[data-quote-form]");

  if (quoteFlow && datePickerDialog && quoteForm && quoteFlow.dataset.ready !== "true") {
    quoteFlow.dataset.ready = "true";
    const text = JSON.parse(quoteFlow.dataset.quoteText ?? "{}") as Record<string, string>;
    const languageTag = quoteFlow.dataset.languageTag ?? "es";
    const fallbackBackHref = quoteFlow.dataset.backHref ?? "/";
    const hasNavigableReferrer = (() => {
      try {
        const referrer = new URL(document.referrer);
        return (
          (referrer.protocol === "http:" || referrer.protocol === "https:") &&
          referrer.href !== window.location.href
        );
      } catch {
        return false;
      }
    })();

    const step = quoteFlow.querySelector<HTMLElement>("[data-quote-step]");
    const backButton = quoteFlow.querySelector<HTMLButtonElement>("[data-quote-back]");
    const backButtonLabels = quoteFlow.querySelectorAll<HTMLElement>("[data-quote-back-label]");
    const nextButton = quoteFlow.querySelector<HTMLButtonElement>("[data-quote-next]");
    const nextButtonLabels = quoteFlow.querySelectorAll<HTMLElement>("[data-quote-next-label]");
    const review = quoteFlow.querySelector<HTMLElement>("[data-quote-review]");
    const successToast = document.querySelector<HTMLElement>("[data-quote-success-toast]");
    const toastClose = successToast?.querySelector<HTMLButtonElement>(
      "[data-quote-toast-close]",
    );
    const submitStatus = quoteFlow.querySelector<HTMLElement>("[data-quote-submit-status]");
    const dateInput = quoteForm.elements.namedItem("eventDate") as HTMLInputElement | null;
    const dateUnknown = quoteForm.elements.namedItem("dateUnknown") as HTMLInputElement | null;
    const dateTrigger = quoteFlow.querySelector<HTMLButtonElement>("[data-date-trigger]");
    const dateValue = quoteFlow.querySelector<HTMLElement>("[data-date-value]");
    const dateMonth = datePickerDialog.querySelector<HTMLElement>("[data-date-month]");
    const dateGrid = datePickerDialog.querySelector<HTMLElement>("[data-date-grid]");
    const datePrevious =
      datePickerDialog.querySelector<HTMLButtonElement>("[data-date-previous]");
    const dateNext = datePickerDialog.querySelector<HTMLButtonElement>("[data-date-next]");
    const calendarMonthSelect = quoteForm.elements.namedItem(
      "calendarMonth",
    ) as HTMLSelectElement | null;
    const calendarYearSelect = quoteForm.elements.namedItem(
      "calendarYear",
    ) as HTMLSelectElement | null;
    const phone = quoteForm.elements.namedItem("phone") as HTMLInputElement | null;
    const serviceSelect = quoteForm.elements.namedItem("service") as HTMLSelectElement | null;
    let validationAttempted = false;
    let reviewing = false;
    let editingFromReview = false;
    let submitting = false;
    let toastTimer: number | undefined;
    const today = new Date();
    today.setHours(0, 0, 0, 0);
    let calendarMonth = new Date(today.getFullYear(), today.getMonth(), 1);

    const requestedService = new URLSearchParams(window.location.search).get("service")?.trim();
    if (serviceSelect && requestedService) {
      const matchingOption = Array.from(serviceSelect.options).find(
        (option) => option.dataset.serviceSlug === requestedService,
      );
      if (matchingOption) {
        serviceSelect.value = matchingOption.value;
        serviceSelect.dispatchEvent(new Event("change", { bubbles: true }));
      }
    }

    const setButtonLabels = (labels: NodeListOf<HTMLElement>, value: string) => {
      labels.forEach((label) => {
        label.textContent = value;
      });
    };

    const logFormAction = (action: string) => {
      console.log(`QUOTE FORM ACTION: ${action.toUpperCase()} | STEP: INFORMACIÓN BÁSICA`);
    };

    const toIsoDate = (date: Date) => {
      const year = date.getFullYear();
      const month = String(date.getMonth() + 1).padStart(2, "0");
      const day = String(date.getDate()).padStart(2, "0");
      return `${year}-${month}-${day}`;
    };

    const parseIsoDate = (value: string) => {
      const [year, month, day] = value.split("-").map(Number);
      return year && month && day ? new Date(year, month - 1, day) : null;
    };

    const formatDate = (date: Date) =>
      new Intl.DateTimeFormat(languageTag, {
        day: "numeric",
        month: "long",
        year: "numeric",
      }).format(date);

    const updateDateField = () => {
      const selectedDate = dateInput?.value ? parseIsoDate(dateInput.value) : null;
      if (dateValue)
        dateValue.textContent = selectedDate ? formatDate(selectedDate) : text.selectDate;
    };

    const renderCalendar = (focusIso = "") => {
      if (!dateGrid || !dateMonth) return;
      const year = calendarMonth.getFullYear();
      const month = calendarMonth.getMonth();
      const firstWeekday = (new Date(year, month, 1).getDay() + 6) % 7;
      const daysInMonth = new Date(year, month + 1, 0).getDate();
      const selectedIso = dateInput?.value ?? "";
      const monthName = new Intl.DateTimeFormat(languageTag, { month: "long" }).format(
        calendarMonth,
      );

      dateMonth.textContent = `${monthName.charAt(0).toUpperCase()}${monthName.slice(1)} ${year}`;
      const monthChanged = calendarMonthSelect?.value !== String(month);
      const yearChanged = calendarYearSelect?.value !== String(year);
      if (calendarMonthSelect) calendarMonthSelect.value = String(month);
      if (calendarYearSelect) calendarYearSelect.value = String(year);
      if (monthChanged)
        calendarMonthSelect?.dispatchEvent(new Event("change", { bubbles: true }));
      if (yearChanged)
        calendarYearSelect?.dispatchEvent(new Event("change", { bubbles: true }));
      dateGrid.replaceChildren();

      for (let index = 0; index < 42; index += 1) {
        const cell = document.createElement("span");
        cell.setAttribute("role", "gridcell");
        const day = index - firstWeekday + 1;

        if (day > 0 && day <= daysInMonth) {
          const date = new Date(year, month, day);
          const iso = toIsoDate(date);
          const button = document.createElement("button");
          button.type = "button";
          button.textContent = String(day);
          button.dataset.date = iso;
          button.tabIndex = -1;
          button.setAttribute("aria-label", formatDate(date));
          cell.setAttribute("aria-selected", String(iso === selectedIso));
          button.disabled = date < today;
          if (iso === toIsoDate(today)) button.dataset.today = "true";
          if (iso === selectedIso) button.dataset.selected = "true";
          cell.append(button);
        }

        dateGrid.append(cell);
      }

      const previousMonthEnd = new Date(year, month, 0);
      if (datePrevious) datePrevious.disabled = previousMonthEnd < today;
      const focusTarget = dateGrid.querySelector<HTMLButtonElement>(
        focusIso ? `[data-date="${focusIso}"]` : '[data-selected="true"]',
      );
      const fallback = dateGrid.querySelector<HTMLButtonElement>("button:not(:disabled)");
      const nextFocus = focusTarget && !focusTarget.disabled ? focusTarget : fallback;
      if (nextFocus) {
        nextFocus.tabIndex = 0;
        nextFocus.focus();
      }
    };

    const openDatePicker = () => {
      if (!dateInput || dateTrigger?.disabled) return;
      if (!datePickerDialog.hidden) {
        closeDatePicker();
        return;
      }
      const selectedDate = dateInput.value ? parseIsoDate(dateInput.value) : null;
      calendarMonth = new Date(
        selectedDate?.getFullYear() ?? today.getFullYear(),
        selectedDate?.getMonth() ?? today.getMonth(),
        1,
      );
      datePickerDialog.hidden = false;
      datePickerDialog.dataset.open = "true";
      dateTrigger?.setAttribute("aria-expanded", "true");
      renderCalendar();
    };

    const closeDatePicker = (restoreFocus = true) => {
      if (datePickerDialog.hidden) return;
      datePickerDialog.hidden = true;
      delete datePickerDialog.dataset.open;
      dateTrigger?.setAttribute("aria-expanded", "false");
      if (restoreFocus) dateTrigger?.focus();
    };

    const moveCalendarFocus = (offset: number) => {
      const active = datePickerDialog.querySelector<HTMLButtonElement>("[data-date]:focus");
      if (!active?.dataset.date) return;
      const date = parseIsoDate(active.dataset.date);
      if (!date) return;
      date.setDate(date.getDate() + offset);
      if (date < today) return;
      if (date.getMonth() !== calendarMonth.getMonth()) {
        calendarMonth = new Date(date.getFullYear(), date.getMonth(), 1);
      }
      renderCalendar(toIsoDate(date));
    };

    const setFieldError = (
      field: HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement,
    ) => {
      if (field.name === "phone") {
        field.setCustomValidity(field.value && !validatePhone(field.value) ? "invalid" : "");
      }

      const error = field
        .closest(".quote-field")
        ?.querySelector<HTMLElement>("[data-quote-error]");
      const message = field.validity.valueMissing
        ? field.dataset.errorRequired
        : field.validity.valid
          ? ""
          : (field.dataset.errorInvalid ?? text.genericInvalid);

      field.setAttribute("aria-invalid", String(!field.validity.valid));
      if (error) error.textContent = message ?? "";
      return field.validity.valid;
    };

    const getFormFields = () =>
      step
        ? Array.from(
            step.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>(
              "input, select, textarea",
            ),
          ).filter((field) => !field.disabled && field.type !== "hidden")
        : [];

    const focusInvalidField = (
      field: HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement,
    ) => {
      const customTrigger = field
        .closest("[data-custom-select]")
        ?.querySelector<HTMLButtonElement>("[data-custom-select-trigger]");
      const target = customTrigger ?? field;
      target.focus({ preventScroll: true });
      const bounds = target.getBoundingClientRect();
      const navigationOffset =
        document.querySelector<HTMLElement>(".site-navigation")?.getBoundingClientRect()
          .bottom ?? 0;
      if (bounds.top < navigationOffset || bounds.bottom > window.innerHeight) {
        target.scrollIntoView({
          behavior: window.matchMedia("(prefers-reduced-motion: reduce)").matches
            ? "auto"
            : "smooth",
          block: "center",
        });
      }
    };

    const getFirstInvalidField = () =>
      getFormFields().find((field) => field.getAttribute("aria-invalid") === "true");

    const validateForm = (focusFirstError = true) => {
      if (!step) return false;
      validationAttempted = true;
      const fields = getFormFields();
      const invalidFields = fields.filter((field) => !setFieldError(field));
      if (focusFirstError && invalidFields[0]) focusInvalidField(invalidFields[0]);
      return invalidFields.length === 0;
    };

    const isFormComplete = () => {
      if (!step) return false;
      return getFormFields().every((field) => field.validity.valid);
    };

    const updatePrimaryAction = () => {
      if (!nextButton || submitting) return;
      const formComplete = isFormComplete();
      nextButton.disabled = false;
      setButtonLabels(
        nextButtonLabels,
        reviewing
          ? text.submit
          : editingFromReview
            ? text.saveChanges
            : formComplete
              ? text.review
              : text.submit,
      );
    };

    const updateView = (focusHeading = true) => {
      if (step) step.hidden = reviewing;
      if (review) review.hidden = !reviewing;
      if (backButton) {
        setButtonLabels(backButtonLabels, editingFromReview ? text.backToReview : text.back);
        backButton.setAttribute(
          "aria-label",
          editingFromReview
            ? text.backToReview
            : reviewing
              ? text.backToForm
              : text.backToPreviousPage,
        );
      }
      updatePrimaryAction();
      if (focusHeading) {
        const heading = reviewing
          ? review?.querySelector<HTMLElement>("h2")
          : step?.querySelector<HTMLElement>("h2");
        heading?.focus();
      }
    };

    const setReviewValue = (name: string, value: string) => {
      const target = review?.querySelector<HTMLElement>(`[data-review-value="${name}"]`);
      if (target) target.textContent = value || text.dateNotIndicated;
    };

    const populateReview = () => {
      const formData = new FormData(quoteForm);
      const languageSelect = quoteForm.elements.namedItem(
        "preferredLanguage",
      ) as HTMLSelectElement | null;
      const selectedDate = dateInput?.value ? parseIsoDate(dateInput.value) : null;
      setReviewValue("fullName", String(formData.get("fullName") ?? ""));
      setReviewValue("email", String(formData.get("email") ?? ""));
      const phoneValue = String(formData.get("phone") ?? "");
      setReviewValue("phone", phoneValue ? `+1 ${phoneValue}` : "");
      setReviewValue(
        "preferredLanguage",
        languageSelect?.selectedOptions[0]?.textContent?.trim() ?? "",
      );
      setReviewValue("service", serviceSelect?.selectedOptions[0]?.textContent?.trim() ?? "");
      setReviewValue("eventType", String(formData.get("eventType") ?? ""));
      setReviewValue(
        "eventDate",
        formData.get("dateUnknown")
          ? text.reviewDateMissing
          : selectedDate
            ? formatDate(selectedDate)
            : text.dateNotIndicated,
      );
      setReviewValue("guestRange", String(formData.get("guestRange") ?? ""));
    };

    const showReview = () => {
      populateReview();
      reviewing = true;
      editingFromReview = false;
      if (submitStatus) submitStatus.textContent = "";
      updateView();
    };

    const resetFlow = () => {
      quoteForm.reset();
      quoteForm.querySelectorAll<HTMLSelectElement>("select").forEach((select) => {
        select.dispatchEvent(new Event("change", { bubbles: true }));
      });
      reviewing = false;
      editingFromReview = false;
      validationAttempted = false;
      submitting = false;
      if (submitStatus) submitStatus.textContent = "";
      if (dateTrigger) dateTrigger.disabled = false;
      updateDateField();
      updateView(false);
    };

    const createSubmission = (): LeadFormInput => {
      const formData = new FormData(quoteForm);
      return {
        fullName: String(formData.get("fullName") ?? ""),
        email: String(formData.get("email") ?? ""),
        phone: String(formData.get("phone") ?? ""),
        service: String(formData.get("service") ?? ""),
        eventType: String(formData.get("eventType") ?? ""),
        eventDate: formData.get("dateUnknown")
          ? null
          : String(formData.get("eventDate") || "") || null,
        guestRange: String(formData.get("guestRange") ?? ""),
        preferredLanguage: String(formData.get("preferredLanguage") || "") || null,
      };
    };

    const submitQuote = (fields: LeadFormInput) =>
      new Promise<void>((resolve, reject) => {
        const request = new CustomEvent<QuoteSubmissionDetail>("quote:submit-request", {
          bubbles: true,
          cancelable: true,
          detail: { fields, venueFiles: [], resolve, reject },
        });
        const connected = !quoteForm.dispatchEvent(request);
        if (!connected) reject(new Error("Quote transport is not configured."));
      });

    const isLeadApiError = (reason: unknown): reason is LeadApiError => {
      if (typeof reason !== "object" || reason === null) return false;
      const candidate = reason as Record<string, unknown>;
      return typeof candidate.error === "string" && typeof candidate.message === "string";
    };

    const showSubmissionError = (error: LeadApiError) => {
      if (submitStatus) submitStatus.textContent = error.message;
      if (!error.field) return;

      const field = quoteForm.elements.namedItem(error.field);
      if (
        !(field instanceof HTMLInputElement) &&
        !(field instanceof HTMLSelectElement) &&
        !(field instanceof HTMLTextAreaElement)
      )
        return;

      field.setAttribute("aria-invalid", "true");
      const fieldError = field
        .closest(".quote-field")
        ?.querySelector<HTMLElement>("[data-quote-error]");
      if (fieldError) fieldError.textContent = error.message;
      reviewing = false;
      updateView(false);
      const customTrigger = field
        .closest("[data-custom-select]")
        ?.querySelector<HTMLButtonElement>("[data-custom-select-trigger]");
      (customTrigger ?? field).focus();
    };

    const hideSuccessToast = () => {
      if (!successToast || successToast.hidden) return;
      window.clearTimeout(toastTimer);
      successToast.dataset.state = "closed";
      window.setTimeout(() => {
        successToast.hidden = true;
      }, 320);
    };

    const showSuccessToast = () => {
      if (!successToast) return;
      window.clearTimeout(toastTimer);
      successToast.hidden = false;
      requestAnimationFrame(() => {
        successToast.dataset.state = "open";
      });
      toastTimer = window.setTimeout(hideSuccessToast, 5500);
    };

    const submitReview = async () => {
      if (!nextButton || submitting) return;
      if (!validateForm(false)) {
        reviewing = false;
        updateView(false);
        const firstInvalid = getFirstInvalidField();
        if (firstInvalid) requestAnimationFrame(() => focusInvalidField(firstInvalid));
        return;
      }
      submitting = true;
      nextButton.disabled = true;
      setButtonLabels(nextButtonLabels, text.submitting);
      if (submitStatus) submitStatus.textContent = text.submitStatus;
      try {
        await submitQuote(createSubmission());
        resetFlow();
        showSuccessToast();
      } catch (reason) {
        const error = isLeadApiError(reason)
          ? reason
          : {
              error: "Submission error",
              message: text.submissionError,
            };
        showSubmissionError(error);
        nextButton.disabled = false;
        setButtonLabels(nextButtonLabels, reviewing ? text.submit : text.review);
      } finally {
        submitting = false;
      }
    };

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && !datePickerDialog.hidden) {
        event.preventDefault();
        closeDatePicker();
      }
    });

    logFormAction("open");
    nextButton?.addEventListener("click", () => {
      if (reviewing) {
        void submitReview();
        return;
      }
      if (!validateForm()) return;
      logFormAction(editingFromReview ? "save changes" : "review");
      showReview();
    });
    toastClose?.addEventListener("click", hideSuccessToast);
    backButton?.addEventListener("click", () => {
      if (reviewing) {
        reviewing = false;
        logFormAction("back");
        updateView();
        return;
      }
      if (editingFromReview) {
        showReview();
        return;
      }
      if (hasNavigableReferrer) {
        window.history.back();
      } else {
        window.location.assign(fallbackBackHref);
      }
    });
    review?.querySelectorAll<HTMLButtonElement>("[data-quote-edit-step]").forEach((button) => {
      button.addEventListener("click", () => {
        reviewing = false;
        editingFromReview = true;
        logFormAction("edit");
        updateView();
      });
    });

    dateTrigger?.addEventListener("click", openDatePicker);
    datePrevious?.addEventListener("click", () => {
      calendarMonth = new Date(calendarMonth.getFullYear(), calendarMonth.getMonth() - 1, 1);
      renderCalendar();
    });
    dateNext?.addEventListener("click", () => {
      calendarMonth = new Date(calendarMonth.getFullYear(), calendarMonth.getMonth() + 1, 1);
      renderCalendar();
    });
    const selectCalendarPeriod = () => {
      if (!calendarMonthSelect || !calendarYearSelect) return;
      const nextMonth = new Date(
        Number(calendarYearSelect.value),
        Number(calendarMonthSelect.value),
        1,
      );
      const currentMonth = new Date(today.getFullYear(), today.getMonth(), 1);
      calendarMonth = nextMonth < currentMonth ? currentMonth : nextMonth;
      renderCalendar();
    };
    calendarMonthSelect?.addEventListener("change", selectCalendarPeriod);
    calendarYearSelect?.addEventListener("change", selectCalendarPeriod);
    dateGrid?.addEventListener("click", (event) => {
      const target = event.target;
      if (!(target instanceof Element) || !dateInput) return;
      const day = target.closest<HTMLButtonElement>("[data-date]");
      if (!day?.dataset.date || day.disabled) return;
      dateInput.value = day.dataset.date;
      updateDateField();
      closeDatePicker();
    });
    dateGrid?.addEventListener("keydown", (event) => {
      const offsets: Record<string, number> = {
        ArrowLeft: -1,
        ArrowRight: 1,
        ArrowUp: -7,
        ArrowDown: 7,
      };
      const offset = offsets[event.key];
      if (!offset) return;
      event.preventDefault();
      moveCalendarFocus(offset);
    });
    document.addEventListener("pointerdown", (event) => {
      const target = event.target;
      if (
        !datePickerDialog.hidden &&
        target instanceof Node &&
        !datePickerDialog.contains(target) &&
        !dateTrigger?.contains(target)
      ) {
        closeDatePicker(false);
      }
    });

    quoteForm.addEventListener("input", (event) => {
      const field = event.target;
      if (phone && field === phone) {
        phone.value = phone.value.replace(/[^0-9]/g, "").slice(0, 10);
      }
      if (
        validationAttempted &&
        (field instanceof HTMLInputElement ||
          field instanceof HTMLSelectElement ||
          field instanceof HTMLTextAreaElement)
      ) {
        setFieldError(field);
      }
      updatePrimaryAction();
    });
    quoteForm.addEventListener("submit", (event) => event.preventDefault());
    quoteForm.addEventListener("change", (event) => {
      const field = event.target;
      if (field instanceof HTMLInputElement && field === dateUnknown && dateInput) {
        dateInput.disabled = field.checked;
        if (field.checked) dateInput.value = "";
        if (dateTrigger) dateTrigger.disabled = field.checked;
        updateDateField();
      }
      updatePrimaryAction();
    });
  }
</script>
