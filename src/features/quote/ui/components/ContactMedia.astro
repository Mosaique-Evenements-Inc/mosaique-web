---
import { heroVideo } from "@/assets/video/delivery";
---

<figure class="contact-media" data-media-status="ready" aria-hidden="true">
  <video autoplay muted loop playsinline preload="metadata" poster={heroVideo.poster}>
    {heroVideo.sources.map((source) => <source src={source.src} type={source.type} />)}
  </video>
</figure>
