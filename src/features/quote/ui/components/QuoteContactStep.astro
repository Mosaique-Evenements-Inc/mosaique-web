---
import { getQuoteContent } from "../../content/quote";
import { getQuoteTranslations } from "../../i18n";
import { getLocaleFromUrl } from "@/core/i18n";
import CustomSelect from "./CustomSelect.astro";

const locale = getLocaleFromUrl(Astro.url);
const quoteText = getQuoteTranslations(locale);
const quoteContent = getQuoteContent(locale);
const preferredLanguageValue = locale;
---

<section class="quote-step__section" aria-labelledby="quote-contact-title">
  <header>
    <h3 id="quote-contact-title">{quoteText.contact}</h3>
  </header>

  <div class="quote-fields">
    <label class="quote-field quote-field--wide">
      <span>{quoteText.fullName} <strong aria-hidden="true">*</strong></span>
      <input
        type="text"
        name="fullName"
        autocomplete="name"
        required
        aria-describedby="quote-full-name-error"
        data-error-required={quoteText.requiredFullName}
      />
      <small id="quote-full-name-error" data-quote-error></small>
    </label>

    <label class="quote-field">
      <span>{quoteText.email} <strong aria-hidden="true">*</strong></span>
      <input
        type="email"
        name="email"
        autocomplete="email"
        required
        aria-describedby="quote-email-error"
        data-error-required={quoteText.requiredEmail}
        data-error-invalid={quoteText.invalidEmail}
      />
      <small id="quote-email-error" data-quote-error></small>
    </label>

    <label class="quote-field">
      <span>{quoteText.phone} <strong aria-hidden="true">*</strong></span>
      <span class="quote-field__control quote-field__control--phone">
        <span class="quote-field__phone-prefix" aria-hidden="true">🇨🇦 +1</span>
        <input
          type="tel"
          name="phone"
          autocomplete="tel"
          inputmode="numeric"
          pattern="[0-9]{7,10}"
          maxlength="10"
          required
          aria-describedby="quote-phone-error"
          data-error-required={quoteText.requiredPhone}
          data-error-invalid={quoteText.invalidPhone}
        />
      </span>
      <small id="quote-phone-error" data-quote-error></small>
    </label>

    <div class="quote-field quote-field--wide">
      <span id="quote-preferred-language-label">{quoteText.preferredLanguage}</span>
      <CustomSelect
        id="quote-preferred-language"
        name="preferredLanguage"
        placeholder={quoteText.noPreference}
        ariaLabel={quoteText.preferredLanguage}
        options={quoteContent.preferredLanguages.map((language) => ({
          value: language.value,
          label: language.label,
          selected: language.value === preferredLanguageValue,
        }))}
      />
      <small data-quote-error></small>
    </div>
  </div>
</section>
