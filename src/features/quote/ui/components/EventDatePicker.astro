---
import Icon from "@/core/common/ui/components/Icon.astro";
import { getQuoteTranslations } from "../../i18n";
import { getLocaleFromUrl } from "@/core/i18n";

const quoteText = getQuoteTranslations(getLocaleFromUrl(Astro.url));
---

<dialog
  id="date-picker-dialog"
  class="date-picker-dialog"
  data-date-picker-dialog
  aria-labelledby="date-picker-month"
>
  <div class="date-picker-dialog__panel">
    <header>
      <button type="button" data-date-previous aria-label={quoteText.previousMonth}>
        <Icon name="arrowLeft" size={20} />
      </button>
      <h2 id="date-picker-month" data-date-month aria-live="polite"></h2>
      <button type="button" data-date-next aria-label={quoteText.nextMonth}>
        <Icon name="arrowRight" size={20} />
      </button>
    </header>

    <div class="date-picker__weekdays" aria-hidden="true">
      {quoteText.weekdays.map((weekday) => <span>{weekday}</span>)}
    </div>

    <div
      class="date-picker__grid"
      data-date-grid
      role="grid"
      aria-labelledby="date-picker-month"
    >
    </div>
  </div>
</dialog>
