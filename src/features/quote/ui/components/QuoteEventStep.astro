---
import { getQuoteContent } from "../../content/quote";
import { getQuoteTranslations } from "../../i18n";
import { getLocaleFromUrl } from "@/core/i18n";
import Icon from "@/core/common/ui/components/Icon.astro";
import CustomSelect from "./CustomSelect.astro";
import EventDatePicker from "./EventDatePicker.astro";

const locale = getLocaleFromUrl(Astro.url);
const quoteContent = getQuoteContent(locale);
const quoteText = getQuoteTranslations(locale);
---

<section class="quote-step__section" aria-labelledby="quote-event-title">
  <header>
    <h3 id="quote-event-title">{quoteText.eventInfo}</h3>
  </header>

  <div class="quote-fields">
    <div class="quote-field quote-field--wide">
      <span>{quoteText.serviceInterest} <strong aria-hidden="true">*</strong></span>
      <CustomSelect
        id="quote-service"
        name="service"
        required
        placeholder={quoteText.selectOption}
        ariaLabel={quoteText.serviceInterest}
        ariaDescribedby="quote-service-error"
        errorRequired={quoteText.requiredService}
        options={quoteContent.services.map((service) => ({
          value: service.value,
          label: service.label,
          data: { "data-service-slug": service.slug },
        }))}
      />
      <small id="quote-service-error" data-quote-error></small>
    </div>

    <div class="quote-field quote-field--wide">
      <span>{quoteText.eventType} <strong aria-hidden="true">*</strong></span>
      <CustomSelect
        id="quote-event-type"
        name="eventType"
        required
        placeholder={quoteText.selectOption}
        ariaLabel={quoteText.eventType}
        ariaDescribedby="quote-event-type-error"
        errorRequired={quoteText.requiredEventType}
        options={quoteContent.eventTypes}
      />
      <small id="quote-event-type-error" data-quote-error></small>
    </div>

    <div
      class="quote-date-group quote-field--wide"
      role="group"
      aria-labelledby="quote-event-date-label"
    >
      <div class="quote-field quote-date-group__date">
        <span id="quote-event-date-label">{quoteText.eventDate}</span>
        <input type="hidden" name="eventDate" />
        <div class="quote-date-control">
          <button
            type="button"
            class="quote-date-trigger"
            data-date-trigger
            aria-controls="date-picker-dialog"
            aria-expanded="false"
          >
            <span data-date-value>{quoteText.selectDate}</span>
            <Icon name="calendar" size={20} />
          </button>

          <EventDatePicker />
        </div>
      </div>

      <label class="quote-check quote-date-group__unknown">
        <input type="checkbox" name="dateUnknown" />
        <span>{quoteText.noDate}</span>
      </label>
    </div>

    <div class="quote-field quote-field--wide">
      <span>{quoteText.guestRange} <strong aria-hidden="true">*</strong></span>
      <CustomSelect
        id="quote-guest-range"
        name="guestRange"
        required
        placeholder={quoteText.selectOption}
        ariaLabel={quoteText.guestRange}
        ariaDescribedby="quote-guests-error"
        errorRequired={quoteText.requiredGuestRange}
        options={quoteContent.guestRanges}
      />
      <small id="quote-guests-error" data-quote-error></small>
    </div>
  </div>
</section>
