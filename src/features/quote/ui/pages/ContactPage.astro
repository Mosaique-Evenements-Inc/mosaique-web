---
import Container from "@/core/common/ui/components/Container.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Footer from "@/features/site-shell/ui/components/Footer.astro";
import Navigation from "@/features/site-shell/ui/components/Navigation.astro";
import ContactMediaPlaceholder from "../components/ContactMediaPlaceholder.astro";
import QuoteForm from "../components/QuoteForm.astro";
import { getQuoteTranslations } from "../../i18n";
import { getLocaleFromUrl } from "@/core/i18n";

import "../styles/contact-page.css";

const quoteText = getQuoteTranslations(getLocaleFromUrl(Astro.url));
---

<BaseLayout
  title={`${quoteText.contact} — MOSAÏQUE ÉVÉNEMENTS`}
  description={quoteText.metadataDescription}
  surface="cinematic"
>
  <Navigation surface="overlay" anchorPrefix="/" />

  <main class="contact-page" id="main-content" tabindex="-1" data-navigation-contrast="light">
    <section class="contact-page__stage" aria-label={quoteText.quoteForm}>
      <Container class="contact-page__container">
        <div class="contact-page__form-column">
          <QuoteForm />
        </div>

        <ContactMediaPlaceholder />
      </Container>
    </section>
  </main>

  <Footer anchorPrefix="/" />
</BaseLayout>
