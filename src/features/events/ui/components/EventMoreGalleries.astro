---
import { eventDetailTranslations, type Event } from "@/features/events";
import { getLocaleFromUrl } from "@/core/i18n";
import Heading from "@/core/common/ui/components/Heading.astro";
import EventPreviewScene from "./EventPreviewScene.astro";

interface Props {
  events: Event[];
}

const { events } = Astro.props;
const eventText = eventDetailTranslations[getLocaleFromUrl(Astro.url)];
const titleId = "more-galleries-heading";
---

<section
  class="event-more-galleries"
  aria-labelledby={titleId}
  data-navigation-contrast="light"
>
  <header class="event-more-galleries__header">
    <Heading as="h2" variant="display-xl" id={titleId}>
      {eventText.moreExperiences}
    </Heading>
  </header>

  <div class="event-more-galleries__sequence">
    {
      events.map((event, index) => (
        <EventPreviewScene event={event} index={index} isLast={index === events.length - 1} />
      ))
    }
  </div>
</section>
