---
import { Picture } from "astro:assets";

import {
  eventImageFallbackFormat,
  eventImageFormats,
  eventImageWidths,
} from "@/assets/images/events/delivery";
import {
  eventDetailTranslations,
  getEventHref,
  getLocalizedEvent,
  getLocalizedEventCategory,
  type Event,
} from "@/features/events";
import { getLocaleFromUrl } from "@/core/i18n";
import Heading from "@/core/common/ui/components/Heading.astro";
import Text from "@/core/common/ui/components/Text.astro";

interface Props {
  event: Event;
  index: number;
  isLast: boolean;
}

const { event, index, isLast } = Astro.props;
const locale = getLocaleFromUrl(Astro.url);
const localizedEvent = getLocalizedEvent(event, locale);
const media = localizedEvent.featuredMedia;
const category = getLocalizedEventCategory(localizedEvent.categoryId, locale);
const eventText = eventDetailTranslations[locale];
---

<article
  class:list={["event-more-galleries__preview", { "is-last": isLast }]}
  data-content-status={event.status}
  style={`--event-scene-index: ${index + 1}`}
>
  <a
    class="event-more-galleries__link"
    href={getEventHref(localizedEvent, locale)}
    aria-label={`${eventText.nextExperience}: ${localizedEvent.title}`}
  >
    <div class="event-more-galleries__media" aria-hidden="true">
      <div class="event-more-galleries__media-inner">
        {
          media.kind === "image" ? (
            <Picture
              src={media.src}
              alt=""
              formats={eventImageFormats}
              fallbackFormat={eventImageFallbackFormat}
              widths={eventImageWidths}
              sizes="100vw"
              loading="lazy"
              decoding="async"
            />
          ) : media.kind === "video" ? (
            <video
              src={media.src}
              poster={media.poster}
              muted
              playsinline
              preload="metadata"
              tabindex="-1"
            />
          ) : (
            <span class="event-more-galleries__placeholder">
              <span />
              <span />
            </span>
          )
        }
        <span class="event-more-galleries__overlay"></span>
      </div>
    </div>

    <div class="event-more-galleries__copy">
      <Text as="span" variant="caption" tone="inverse" class="event-more-galleries__label">
        {category.label}
      </Text>
      <Heading as="h3" variant="display-lg">{localizedEvent.title}</Heading>
    </div>
  </a>
</article>
