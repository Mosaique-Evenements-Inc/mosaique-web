---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Footer from "@/features/site-shell/ui/components/Footer.astro";
import Navigation from "@/features/site-shell/ui/components/Navigation.astro";
import type { Event } from "@/features/events";
import EventContactMarquee from "../components/EventContactMarquee.astro";
import EventGallery from "../components/EventGallery.astro";
import EventHeader from "../components/EventHeader.astro";
import EventMoreGalleries from "../components/EventMoreGalleries.astro";

import "../styles/event-detail.css";

interface Props {
  event: Event;
  nextEvents: Event[];
}

const { event, nextEvents } = Astro.props;
---

<BaseLayout
  title={`${event.title} — MOSAÏQUE EVENTS`}
  description={event.description}
  surface="cinematic"
>
  <Navigation surface="overlay" anchorPrefix="/" />
  <main class="event-detail" id="main-content" tabindex="-1" data-navigation-contrast="light">
    <div class="event-detail__chapter" data-content-status={event.status}>
      <EventHeader title={event.title} description={event.description} status={event.status} />
      <EventGallery
        featuredMedia={event.featuredMedia}
        images={event.gallery}
        slug={event.slug}
        title={event.title}
      />
    </div>
    <EventMoreGalleries events={nextEvents} />
    <EventContactMarquee />
  </main>
  <Footer anchorPrefix="/" />
</BaseLayout>
