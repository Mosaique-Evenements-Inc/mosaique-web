---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"div"> {
  overlap?: boolean;
  panelClass?: string;
}

const { class: className, overlap = false, panelClass, ...attrs } = Astro.props;
---

<div class:list={["panel-reveal", { "panel-reveal--overlap": overlap }, className]} {...attrs}>
  <div class="panel-reveal__lead">
    <slot name="lead" />
  </div>
  <div class:list={["panel-reveal__panel", panelClass]}>
    <slot />
  </div>
</div>

<style>
  .panel-reveal {
    position: relative;
  }

  .panel-reveal__lead {
    position: sticky;
    top: 0;
  }

  .panel-reveal__panel {
    position: relative;
    z-index: var(--primitive-z-content);
  }

  .panel-reveal--overlap {
    margin-block-start: -100svh;
  }

  .panel-reveal--overlap .panel-reveal__lead {
    pointer-events: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .panel-reveal--overlap {
      margin-block-start: 0;
    }

    .panel-reveal__lead {
      position: relative;
    }
  }
</style>
