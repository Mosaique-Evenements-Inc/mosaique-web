---
import {
  ArrowLeft,
  ArrowRight,
  Calendar,
  Check,
  CheckCircle,
  CoinsSwap,
  Copy,
  DesignNib,
  Facebook,
  Globe,
  Instagram,
  Linkedin,
  MenuScale,
  MoreHoriz,
  HalfMoon,
  NavArrowDown,
  NetworkRight,
  Plus,
  PlusCircle,
  SendMail,
  ShareIos,
  Sparks,
  Strategy,
  SunLight,
  Tiktok,
  Upload,
  Whatsapp,
  X,
  Xmark,
} from "iconoir-react";

const icons = {
  arrowLeft: ArrowLeft,
  arrowRight: ArrowRight,
  calendar: Calendar,
  check: Check,
  checkCircle: CheckCircle,
  coinsSwap: CoinsSwap,
  copy: Copy,
  designNib: DesignNib,
  facebook: Facebook,
  globe: Globe,
  instagram: Instagram,
  linkedin: Linkedin,
  menu: MenuScale,
  moreHoriz: MoreHoriz,
  halfMoon: HalfMoon,
  navArrowDown: NavArrowDown,
  networkRight: NetworkRight,
  plus: Plus,
  plusCircle: PlusCircle,
  sendMail: SendMail,
  shareIos: ShareIos,
  sparks: Sparks,
  strategy: Strategy,
  sunLight: SunLight,
  tiktok: Tiktok,
  upload: Upload,
  whatsapp: Whatsapp,
  x: X,
  xmark: Xmark,
} as const;

export type IconName = keyof typeof icons;

interface Props {
  name: IconName;
  size?: number;
  strokeWidth?: number;
  class?: string;
}

const { name, size = 20, strokeWidth = 1.5, class: className } = Astro.props;
const SelectedIcon = icons[name];
---

<SelectedIcon
  width={size}
  height={size}
  strokeWidth={strokeWidth}
  className={className}
  aria-hidden="true"
  focusable="false"
/>
