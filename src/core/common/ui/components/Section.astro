---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"section"> {
  minViewport?: boolean;
  spacing?: "none" | "compact" | "standard" | "spacious";
}

const { minViewport = false, spacing = "standard", class: className, ...attrs } = Astro.props;

const spacingClass = {
  none: "py-0",
  compact: "py-[calc(var(--space-section)*0.5)]",
  standard: "py-[var(--space-section)]",
  spacious: "py-[calc(var(--space-section)*1.25)]",
}[spacing];
---

<section
  class:list={[spacingClass, minViewport && "min-h-[var(--layout-section-min)]", className]}
  {...attrs}
>
  <slot />
</section>
